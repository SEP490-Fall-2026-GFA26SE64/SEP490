    "description": {
      "no": {
        "literal": "Hente informasjon fra en database eller et informasjonssystem ved hjelp av datamaskinspråk som er utformet for å hente ut data.",
        "mimetype": "plain/text"
      },
      "de": {
        "literal": "Abrufen von Informationen aus einer Datenbank oder einem Informationssystem mithilfe von Computersprachen für die Abfrage von Daten.",
        "mimetype": "plain/text"
      },
      "fi": {
        "literal": "Hakea tietoja tietokannasta tai tietojärjestelmästä käyttäen ohjelmointikieliä, jotka on tarkoitettu tietojen hakuun.",
        "mimetype": "plain/text"
      },
      "pt": {
        "literal": "Obter informações a partir de uma base de dados ou de um sistema de informação utilizando uma linguagem informática concebida para a recuperação de dados.",
        "mimetype": "plain/text"
      },
      "bg": {
        "literal": "Извлича информация от база данни или информационна система чрез използване на компютърни езици, предназначени за извличане на данни.",
        "mimetype": "plain/text"
      },
      "lt": {
        "literal": "Gauti informaciją iš duomenų bazės arba informacinės sistemos vartojant kompiuterines kalbas, skirtas duomenims gauti.",
        "mimetype": "plain/text"
      },
      "hr": {
        "literal": "Dohvaćati informacije iz baze podataka ili informacijskog sustava upotrebom računalnih jezika namijenjenima za dohvat podataka.",
        "mimetype": "plain/text"
      },
      "lv": {
        "literal": "Izgūt informāciju no datubāzes vai informācijas sistēmas, izmantojot datorvalodas, kas paredzētas datu izgūšanai.",
        "mimetype": "plain/text"
      },
      "fr": {
        "literal": "Extraire des informations à partir d’une base de données ou d’un système d’information utilisant des langages informatiques conçus pour la récupération de données.",
        "mimetype": "plain/text"
      },
      "hu": {
        "literal": "Adatbázisból vagy információs rendszerből az adatok lekérdezése céljára szolgáló számítógépes nyelv alkalmazása.",
        "mimetype": "plain/text"
      },
      "uk": {
        "literal": "Отримувати інформацію з бази даних або інформаційної системи за допомогою комп’ютерних мов, призначених для отримання даних.\n\t",
        "mimetype": "plain/text"
      },
      "sk": {
        "literal": "Získavať informácie z databázy alebo informačného systému použitím počítačových jazykov určených na vyhľadávanie údajov.",
        "mimetype": "plain/text"
      },
      "sl": {
        "literal": "Pridobiti informacije iz zbirke podatkov ali informacijskega sistema z uporabo računalniških jezikov, zasnovanih za pridobivanje podatkov.",
        "mimetype": "plain/text"
      },
      "ga": {
        "literal": "Faisnéis a aisghabháil ó bhunachar sonraí nó ó chóras faisnéise, agus úsáid á baint as teangacha ríomhaire atá ceaptha chun sonraí a aisghabháil.",
        "mimetype": "plain/text"
      },
      "sv": {
        "literal": "Hämta information från en databas eller ett informationssystem med hjälp av datorspråk avsett för hämtning av data.",
        "mimetype": "plain/text"
      },
      "el": {
        "literal": "Ανάκτηση πληροφοριών από βάση δεδομένων ή σύστημα πληροφοριών με τη χρήση ηλεκτρονικών γλωσσών που έχουν σχεδιαστεί για την ανάκτηση δεδομένων.",
        "mimetype": "plain/text"
      },
      "mt": {
        "literal": "Ikseb informazzjoni minn bażi tad-data jew sistema ta’ informazzjoni bl-użu ta’ lingwi tal-kompjuter maħsuba għall-kisba tad-data.",
        "mimetype": "plain/text"
      },
      "en": {
        "literal": "Retrieve information from a database or information system using computer languages designed for the retrieval of data.",
        "mimetype": "plain/text"
      },
      "is": {
        "literal": "Sækir upplýsingar úr gagnagrunni eða upplýsingakerfi, þar sem tölvuforrit eru notuð til gagnaöflunar.",
        "mimetype": "plain/text"
      },
      "it": {
        "literal": "Recuperare informazioni da una banca dati o da un sistema informativo utilizzando linguaggi informatici usati per reperire i dati.",
        "mimetype": "plain/text"
      },
      "es": {
        "literal": "Recuperar información de una base de datos o sistema de información utilizando lenguajes informáticos diseñados para la recuperación de datos.",
        "mimetype": "plain/text"
      },
      "et": {
        "literal": "Teabe hankimine andmebaasist või infosüsteemist, kasutades andmeotsinguks kavandatud arvutikeeli.",
        "mimetype": "plain/text"
      },
      "cs": {
        "literal": "Získávat informace z databáze nebo informačního systému za použití počítačových jazyků určených k vyhledávání dat.",
        "mimetype": "plain/text"
      },
      "ar": {
        "literal": "استرجاع المعلومات من قاعدة البيانات أو نظام المعلومات باستخدام لغات الحاسب الآلي المصممة لاسترجاع البيانات.",
        "mimetype": "plain/text"
      },
      "pl": {
        "literal": "Pobierać informacje z bazy danych lub systemu informacyjnego z wykorzystaniem języków komputerowych przeznaczonych do pobierania danych.",
        "mimetype": "plain/text"
      },
      "da": {
        "literal": "Hente oplysninger fra en database eller et informationssystem ved hjælp af computersprog, der er udviklet til at hente data.",
        "mimetype": "plain/text"
      },
      "ro": {
        "literal": "Extrage informații dintr-o bază de date sau un sistem de informații utilizând limbaje informatice destinate extragerii datelor.",
        "mimetype": "plain/text"
      },
      "nl": {
        "literal": "Informatie opvragen uit een databank of informatiesysteem met behulp van computertalen die zijn ontworpen voor het opvragen van gegevens.",
        "mimetype": "plain/text"
      }
    },
