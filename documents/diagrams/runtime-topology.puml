@startuml
!pragma layout smetana
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor Browser
component "React/Vite (dev)\nCaddy (production)" as Web
component "Spring Boot API" as API
component "Spring Boot migrate profile" as Migrate
database "PostgreSQL" as PG
database "Neo4j" as Graph

Browser --> Web
Web --> API : /api
API --> PG
API --> Graph
Migrate --> PG : Flyway V1-V6
Migrate --> Graph : V5 catalog constraints
@enduml