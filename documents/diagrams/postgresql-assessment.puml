@startuml
!pragma layout smetana
top to bottom direction
skinparam shadowing false
hide circle
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
title PostgreSQL 17.6 / platform / V1-V23\nLegacy assessment and shared learning (32 tables)
legend top left
PK = primary key; FK = foreign-key column; ? = nullable
Arrows: referenced parent -> referencing child; no cardinality inference.
External tables are reference stubs. Full constraints/indexes/triggers: schema catalog.
endlegend
class evidence_policy_version {
  policy_version_id : uuid [PK]
  policy_name : text
  version : integer
  configuration : jsonb
  configuration_hash : platform.content_hash
  approved_by? : uuid [FK]
  approved_at? : timestamp with time zone
}
class model_version {
  model_version_id : uuid [PK]
  algorithm : text
  version : text
  parameter_hash : platform.content_hash
  configuration : jsonb
  artifact_ref : text
  approved_by? : uuid [FK]
  approved_at? : timestamp with time zone
}
class question_bank {
  question_bank_id : uuid [PK]
  name : text
  created_by : uuid [FK]
  created_at : timestamp with time zone
}
class item_version {
  item_version_id : uuid [PK]
  item_id : uuid
  version : integer
  question_bank_id : uuid [FK]
  prompt : text
  response_schema : jsonb
  protected_key : jsonb
  publication_state : text
  content_hash : platform.content_hash
  micro_skill_id? : text
  micro_skill_name_snapshot? : text
  difficulty? : text
}
class assessment_version {
  assessment_version_id : uuid [PK]
  assessment_id : uuid
  version : integer
  title : text
  purpose : text
  pass_threshold? : platform.unit_interval
  scoring_version : text
  publication_state : text
  content_hash : platform.content_hash
  blueprint_id? : uuid [FK]
  blueprint_version? : integer [FK]
  generation_seed? : bigint
  created_by? : uuid [FK]
  created_at? : timestamp with time zone
  generation_idempotency_key? : text
  generation_request_hash? : platform.content_hash
  reviewed_by? : uuid [FK]
  reviewed_at? : timestamp with time zone
  reviewed_content_hash? : platform.content_hash
  draft_revision : bigint
  baseline_candidate_state? : text
}
class assessment_availability {
  assessment_version_id : uuid [PK, FK]
  revision : bigint [PK]
  available : boolean
  decided_by : uuid [FK]
  decided_at : timestamp with time zone
}
class assessment_item {
  assessment_version_id : uuid [PK, FK]
  item_position : integer [PK]
  item_version_id : uuid [FK]
  required : boolean
  scoring_weight : numeric
  role_id? : text
  role_name_snapshot? : text
}
class item_skill_mapping {
  mapping_version_id : uuid [PK]
  item_version_id : uuid [FK]
  skill_ref_id : uuid [FK]
  skill_kind : text [FK]
  evidence_weight : platform.positive_weight
}
class baseline_blueprint {
  blueprint_id : uuid [PK]
  occupation_id? : text
  created_by : uuid [FK]
  created_at : timestamp with time zone
  organization_id? : uuid [FK]
}
class baseline_blueprint_version {
  blueprint_id : uuid [PK, FK]
  version : integer [PK]
  name : text
  occupation_id? : text
  occupation_name_snapshot? : text
  created_by : uuid [FK]
  created_at : timestamp with time zone
  idempotency_key : text
  request_hash : platform.content_hash
}
class baseline_blueprint_role {
  blueprint_id : uuid [PK, FK]
  blueprint_version : integer [PK, FK]
  role_id : text [PK]
  role_name_snapshot : text
  enabled : boolean
  total_question_count : integer
  easy_score_weight : platform.unit_interval
  medium_score_weight : platform.unit_interval
  hard_score_weight : platform.unit_interval
}
class baseline_blueprint_skill {
  blueprint_id : uuid [PK, FK]
  blueprint_version : integer [PK, FK]
  role_id : text [PK, FK]
  micro_skill_id : text [PK]
  micro_skill_name_snapshot : text
  easy_question_count : integer
  medium_question_count : integer
  hard_question_count : integer
}
class baseline_assessment_series {
  organization_id : uuid [PK, FK]
  occupation_id : text [PK, FK]
  blueprint_id : uuid [FK]
  series_revision : bigint
  working_revision_id? : uuid [FK]
  pending_blueprint_version? : integer [FK]
  open_assessment_version_id? : uuid [FK]
  active_assessment_version_id? : uuid [FK]
  created_at : timestamp with time zone
  updated_at : timestamp with time zone
}
class baseline_blueprint_working_revision {
  working_revision_id : uuid [PK]
  organization_id : uuid [FK]
  occupation_id : text [FK]
  blueprint_id : uuid [FK]
  base_version? : integer [FK]
  revision : bigint
  name : text
  occupation_name_snapshot : text
  roles : jsonb
  state : text
  created_by : uuid [FK]
  created_at : timestamp with time zone
  updated_by : uuid [FK]
  updated_at : timestamp with time zone
  closed_at? : timestamp with time zone
}
class baseline_assessment_transition {
  transition_id : uuid [PK]
  organization_id : uuid [FK]
  occupation_id : text [FK]
  series_revision : bigint
  transition : text
  actor_id : uuid [FK]
  occurred_at : timestamp with time zone
  reason? : text
  previous_working_revision_id? : uuid [FK]
  previous_pending_blueprint_id? : uuid [FK]
  previous_pending_blueprint_version? : integer [FK]
  previous_open_assessment_version_id? : uuid [FK]
  previous_active_assessment_version_id? : uuid [FK]
  working_revision_id? : uuid [FK]
  pending_blueprint_id? : uuid [FK]
  pending_blueprint_version? : integer [FK]
  open_assessment_version_id? : uuid [FK]
  active_assessment_version_id? : uuid [FK]
}
class baseline_management_command {
  actor_id : uuid [PK, FK]
  idempotency_key : text [PK]
  organization_id : uuid [FK]
  occupation_id : text [FK]
  operation : text
  request_hash : platform.content_hash
  response_json : jsonb
  created_at : timestamp with time zone
}
class baseline_answer_reveal_audit {
  answer_reveal_audit_id : uuid [PK]
  organization_id : uuid [FK]
  assessment_version_id : uuid [FK]
  actor_id : uuid [FK]
  revealed_at : timestamp with time zone
  item_count : integer
}
class module_assessment_binding {
  module_ref_id : uuid [PK, FK]
  module_kind : text [FK]
  assessment_version_id : uuid [PK, FK]
  assessment_purpose : text [FK]
  required : boolean
  manifest_hash : platform.content_hash
}
class learning_activity {
  activity_id : uuid [PK]
  learner_id : uuid [FK]
  module_ref_id : uuid [FK]
  module_kind : text [FK]
  kind : text
  required_assessment_set_hash : platform.content_hash
  created_at : timestamp with time zone
}
class activity_requirement {
  activity_id : uuid [PK, FK]
  module_ref_id : uuid [FK]
  assessment_version_id : uuid [PK, FK]
  required : boolean [FK]
  manifest_hash : platform.content_hash [FK]
}
class assessment_assignment {
  assignment_id : uuid [PK]
  learner_id : uuid [FK]
  assessment_version_id : uuid [FK]
  purpose : text [FK]
  activity_id? : uuid [FK]
  activity_context? : uuid
  available_from : timestamp with time zone
  available_until? : timestamp with time zone
  attempt_limit : integer
  status : text
}
class assessment_attempt {
  attempt_id : uuid [PK]
  assignment_id : uuid [FK]
  learner_id : uuid [FK]
  assessment_version_id : uuid [FK]
  activity_id? : uuid
  activity_context? : uuid [FK]
  operation : text
  idempotency_key : text
  request_hash : platform.content_hash
  frozen_context : jsonb
  submission_sequence : bigint
  attempt_number : integer
  accepted_at : timestamp with time zone
}
class item_response {
  attempt_id : uuid [PK, FK]
  item_position : integer [PK, FK]
  assessment_version_id : uuid [FK]
  item_version_id : uuid [FK]
  response_payload : jsonb
}
class assessment_result {
  attempt_id : uuid [PK, FK]
  learner_id : uuid [FK]
  assessment_version_id : uuid [FK]
  activity_id? : uuid
  activity_context? : uuid [FK]
  score : platform.unit_interval
  pass_threshold : platform.unit_interval
  passed? : boolean
  scoring_version : text
  scored_at : timestamp with time zone
}
class evidence_observation {
  observation_id : uuid [PK]
  attempt_id : uuid [FK]
  learner_id : uuid [FK]
  item_position : integer [FK]
  item_version_id : uuid [FK]
  mapping_version_id : uuid [FK]
  skill_ref_id : uuid [FK]
  outcome : boolean
  weight : platform.positive_weight [FK]
  source_kind : text
}
class processing_stream {
  processing_stream_id : uuid [PK]
  learner_id : uuid [FK]
  model_version_id : uuid [FK]
  policy_version_id : uuid [FK]
  created_at : timestamp with time zone
}
class profile_revision {
  profile_revision_id : uuid [PK]
  learner_id : uuid [FK]
  processing_stream_id : uuid [FK]
  model_version_id : uuid [FK]
  policy_version_id : uuid [FK]
  revision_number : bigint
  evidence_watermark : bigint
  status : text
  created_at : timestamp with time zone
}
class mastery_estimate {
  profile_revision_id : uuid [PK, FK]
  skill_ref_id : uuid [PK, FK]
  skill_kind : text [FK]
  objective_value? : platform.unit_interval
  provisional_value? : platform.unit_interval
  effective_value? : platform.unit_interval
  evidence_status : text
}
class evidence_application {
  processing_stream_id : uuid [PK, FK]
  observation_id : uuid [PK, FK]
  learner_id : uuid [FK]
  profile_revision_id : uuid [FK]
  applied_at : timestamp with time zone
}
class progress_revision {
  progress_revision_id : uuid [PK]
  learner_id : uuid [FK]
  revision_number : bigint
  activity_snapshot : jsonb
  snapshot_hash : platform.content_hash
  created_at : timestamp with time zone
}
class module_completion {
  activity_id : uuid [PK, FK]
  learner_id : uuid [FK]
  progress_revision_id : uuid [FK]
  completed_at : timestamp with time zone
}
class completion_pass {
  activity_id : uuid [PK, FK]
  assessment_version_id : uuid [PK, FK]
  learner_id : uuid [FK]
  attempt_id : uuid [FK]
  passed : boolean [FK]
}
class account <<external>> #F1F5F9
class catalog_reference <<external>> #F1F5F9
class learner_state <<external>> #F1F5F9
class organization <<external>> #F1F5F9
account --> assessment_availability
account --> assessment_version
account --> baseline_answer_reveal_audit
account --> baseline_assessment_transition
account --> baseline_blueprint
account --> baseline_blueprint_version
account --> baseline_blueprint_working_revision
account --> baseline_management_command
account --> evidence_policy_version
account --> model_version
account --> question_bank
activity_requirement --> assessment_assignment
activity_requirement --> completion_pass
assessment_assignment --> assessment_attempt
assessment_attempt --> assessment_result
assessment_attempt --> evidence_observation
assessment_attempt --> item_response
assessment_item --> item_response
assessment_result --> completion_pass
assessment_version --> assessment_assignment
assessment_version --> assessment_availability
assessment_version --> assessment_item
assessment_version --> baseline_answer_reveal_audit
assessment_version --> baseline_assessment_series
assessment_version --> baseline_assessment_transition
assessment_version --> module_assessment_binding
baseline_assessment_series --> baseline_assessment_transition
baseline_assessment_series --> baseline_blueprint_working_revision
baseline_assessment_series --> baseline_management_command
baseline_blueprint --> baseline_assessment_series
baseline_blueprint --> baseline_blueprint_version
baseline_blueprint_role --> baseline_blueprint_skill
baseline_blueprint_version --> assessment_version
baseline_blueprint_version --> baseline_assessment_series
baseline_blueprint_version --> baseline_assessment_transition
baseline_blueprint_version --> baseline_blueprint_role
baseline_blueprint_version --> baseline_blueprint_working_revision
baseline_blueprint_working_revision --> baseline_assessment_series
baseline_blueprint_working_revision --> baseline_assessment_transition
catalog_reference --> item_skill_mapping
catalog_reference --> learning_activity
catalog_reference --> mastery_estimate
catalog_reference --> module_assessment_binding
evidence_observation --> evidence_application
evidence_policy_version --> processing_stream
item_response --> evidence_observation
item_skill_mapping --> evidence_observation
item_version --> assessment_item
item_version --> item_skill_mapping
learner_state --> assessment_assignment
learner_state --> learning_activity
learner_state --> processing_stream
learner_state --> progress_revision
learning_activity --> activity_requirement
learning_activity --> assessment_assignment
learning_activity --> module_completion
model_version --> processing_stream
module_assessment_binding --> activity_requirement
module_completion --> completion_pass
organization --> baseline_answer_reveal_audit
organization --> baseline_assessment_series
organization --> baseline_blueprint
processing_stream --> profile_revision
profile_revision --> evidence_application
profile_revision --> mastery_estimate
progress_revision --> module_completion
question_bank --> item_version
@enduml
