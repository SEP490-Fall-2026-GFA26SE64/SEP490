@startuml
!pragma layout smetana
left to right direction
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
title postgresql-assessment - selected source-defined tables; not a live DB capture
entity "assessment_rule_policy_draft" as assessment_rule_policy_draft {
  uuid organization_id <<PK>>
  text purpose <<PK>>
  content_hash scope_key <<PK>>
  uuid id
  bigint revision
  jsonb configuration "NULLABLE"
  content_hash catalog_hash
}
entity "assessment_rule_policy_version" as assessment_rule_policy_version {
  uuid id <<PK>>
  uuid organization_id
  text purpose
  content_hash scope_key "NULLABLE"
  bigint version
  content_hash catalog_hash "NULLABLE"
  jsonb configuration
}
entity "assessment_rule_scoped_activation" as assessment_rule_scoped_activation {
  uuid organization_id <<PK>>
  text purpose <<PK>>
  content_hash scope_key <<PK>>
  uuid current_policy_version_id
  bigint revision
}
entity "assessment_rule_abandoned_draft" as assessment_rule_abandoned_draft {
  uuid id <<PK>>
  uuid organization_id
  text purpose
  content_hash scope_key
}
entity "assessment_rule_policy_version_number_history" as assessment_rule_policy_version_number_history {
  uuid policy_id <<PK>>
  content_hash scope_key
  bigint scoped_version
}
assessment_rule_policy_version --> assessment_rule_scoped_activation : same org purpose scope policy FK
entity "assessment_item_knowledge_mapping" as assessment_item_knowledge_mapping {
  uuid item_version_id <<PK>>
  uuid organization_id
  uuid question_bank_id
  text skill_id
  text knowledge_level
  text outcome_code "NULLABLE legacy metadata"
  boolean mandatory
  content_hash mapping_hash
}
entity "assessment_item_skill_scope" as assessment_item_skill_scope {
  uuid item_version_id <<PK, FK>>
  text skill_version
  text source
}
assessment_item_knowledge_mapping --> assessment_item_skill_scope : append-only version binding V63
note bottom of assessment_item_skill_scope
  Source definition; local V63 applied 2026-11-09.
  Pool = owned Skill + knowledge level + Skill version.
  Original item / mapping hashes and frozen papers retained.
end note
entity "rule_assessment_attempt" as rule_assessment_attempt {
  uuid id <<PK>>
  uuid organization_id
  uuid learner_id
  text purpose
  uuid selection_id
  uuid policy_id
  text state
  timestamptz deadline_at
  text finish_reason "NULLABLE"
  text processing_status
}
entity "rule_assessment_group" as rule_assessment_group {
  uuid attempt_id <<PK>>
  uuid group_id <<PK>>
  text skill_id
  text knowledge_level
  text group_role
  integer total_count
  integer required_correct_count
}
entity "rule_assessment_item" as rule_assessment_item {
  uuid attempt_id <<PK>>
  integer item_position <<PK>>
  uuid group_id
  uuid item_version_id
  jsonb frozen_item
}
entity "rule_assessment_answer" as rule_assessment_answer {
  uuid attempt_id <<PK>>
  integer item_position <<PK>>
  jsonb response
  bigint revision
  uuid source_command
}
entity "rule_assessment_group_result" as rule_assessment_group_result {
  uuid attempt_id <<PK>>
  uuid group_id <<PK>>
  boolean passed
  boolean veto_triggered
  boolean mandatory_satisfied
}
entity "skill_knowledge_evidence" as skill_knowledge_evidence {
  uuid id <<PK>>
  uuid organization_id
  uuid learner_id
  text skill_id
  text knowledge_level
  text source_kind
  uuid source_id
}
entity "skill_knowledge_review" as skill_knowledge_review {
  uuid id <<PK>>
  uuid attempt_id
  uuid group_id
  text state
  uuid resolved_by_evidence_id "NULLABLE"
}
rule_assessment_attempt --> rule_assessment_group : owned attempt
rule_assessment_group --> rule_assessment_item : composite group FK
rule_assessment_item --> assessment_item_knowledge_mapping : exact immutable mapping FK
rule_assessment_item --> rule_assessment_answer : presented item FK
rule_assessment_group --> rule_assessment_group_result : immutable result
rule_assessment_group --> skill_knowledge_review : failed prerequisite FK
skill_knowledge_evidence --> skill_knowledge_review : resolving evidence FK
@enduml
