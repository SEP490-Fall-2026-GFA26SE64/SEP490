@startuml
!pragma layout smetana
left to right direction
hide empty members
hide circle
skinparam shadowing false
skinparam roundcorner 10
skinparam classAttributeIconSize 0
skinparam backgroundColor #F8FAFC
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #64748B
skinparam ArrowColor #475569
skinparam noteBackgroundColor #FFF7ED
skinparam noteBorderColor #D97706
skinparam defaultFontName Arial
skinparam defaultFontSize 14
title Ontology 0.7.0 — Level-owned competencies and RIASEC
class Occupation {
 code : String
 name : String
 jobZone : Integer
 interestRealistic : Float [0,1]
 interestInvestigative : Float [0,1]
 interestArtistic : Float [0,1]
 interestSocial : Float [0,1]
 interestEnterprising : Float [0,1]
 interestConventional : Float [0,1]
}
class TargetRole {
 code : String
 name : String
 scope : String
 canonicalProfileKey : String
}
class Level {
 code : String
 name : String
 rank : Integer
 context : String
 attainmentRule = ALL_MANDATORY_SKILLS
}
class Competency {
 name : String
 description : String
 attainmentRule = ALL_MEMBER_SKILLS_AT_OWNING_LEVEL
}
class MicroSkill {
 name : String
 definition : String
}
class Course {
 title : String
 description : String
}
class LearningModule {
 title : String
 learningOutcome : String
 contentUri : String
 contentType : String
 contentVersion : String
}
Occupation "1" --> "1..*" TargetRole : HAS_ROLE
TargetRole "1" --> "1..*" Level : HAS_LEVEL
Level "1" -up-> "1..*" Competency : HAS_COMPETENCY
Competency "0..*" --> "1..*" MicroSkill : HAS_SKILL
Level "0..*" --> "1..*" MicroSkill : REQUIRES_SKILL\nrequiredScore [0,1], isMandatory,\nexpectedOutcome, rubricId, rubricVersion
Level "1..*" -down-> "1..*" Course : HAS_COURSE
Course "1..*" --> "1..*" LearningModule : HAS_MODULE\nsequence
LearningModule "0..*" -up-> "1..*" MicroSkill : TEACHES
Course --> Course : HAS_COURSE_PREREQUISITE\nrequiredCompletionStatus = PASSED
MicroSkill --> MicroSkill : HAS_SKILL_PREREQUISITE\nreadinessOutcome, requiredScore\nrubricId/version, readinessAssessmentId/version
note top of Competency
Owned by one Level.
All member skills PASS under that Level's requirements
=> Competency ACHIEVED.
No independent score or assessment.
end note
note bottom of Level
Each Level has its own skill, competency and course sets.
Sets may overlap; they need not be identical.
A Competency member must be required by its owning Level.
end note
note bottom of Course
Course A requires B: B must have status PASSED.
Prerequisite graphs must be acyclic.
Course completion does not automatically prove skill mastery.
end note
note top of Occupation
Each TargetRole has one owning Occupation.
Repeated reported titles use distinct role IDs per Occupation.
Shared metadata: id, version, status, reviewStatus,
reviewedBy?, reviewedAt?
end note
@enduml
