@startuml
!pragma layout smetana
top to bottom direction
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 70
skinparam ranksep 65
title Neo4j Knowledge Graph Schema — Latest Entities & Properties (2026-11-19)

class Department {
  id: String [UNIQUE]
  code: String [UNIQUE per org]
  name: String
  organizationId: String
  description: String
  status: String
  version: String [optional]
  source: String [optional]
  createdAt: String
  updatedAt: String
}

class JobPosition {
  id: String [UNIQUE]
  code: String [UNIQUE]
  name: String
  organizationId: String
  version: String
  status: String
  reviewStatus: String [optional]
  description: String [optional]
  source: String [optional]
  createdAt: String [optional]
  updatedAt: String [optional]
  interestRealistic: Integer [0..40, optional]
  interestInvestigative: Integer [0..40, optional]
  interestArtistic: Integer [0..40, optional]
  interestSocial: Integer [0..40, optional]
  interestEnterprising: Integer [0..40, optional]
  interestConventional: Integer [0..40, optional]
}

class TargetRole {
  id: String [UNIQUE]
  organizationId: String
  code: String
  baseCode: String
  name: String
  familyCode: String [links to JobPosition code]
  description: String
  scope: String
  responsibilities: String[]
  status: String
  isStaffingEnabled: Boolean
  version: String
  reviewStatus: String [optional]
  assignedExpertId: String [optional]
  assignedExpertName: String [optional]
  skillTargets: String [JSON]
  levelCompetencies: String [JSON]
  competencyIds: String[]
  rejectionReason: String [optional]
  source: String [optional]
  createdAt: DateTime / String
  updatedAt: DateTime / String
}

class Level {
  id: String [UNIQUE]
  organizationId: String
  code: String
  name: String
  rank: Long
  duration: String
  attainmentRule: String
  status: String
  version: String
  reviewStatus: String [optional]
  memberToken: String [optional]
  sourceFormat: String [optional]
  source: String [optional]
  createdAt: DateTime / String
  updatedAt: DateTime / String
}

class Competency {
  id: String [UNIQUE]
  organizationId: String
  code: String
  name: String
  description: String
  attainmentRule: String
  status: String
  version: String
  reviewStatus: String
  departmentId: String [optional]
  departmentName: String [optional]
  jobPositionCode: String [optional]
  jobPositionTitle: String [optional]
  createdAt: DateTime / String [optional]
  updatedAt: DateTime / String [optional]
}

class MicroSkill {
  id: String [UNIQUE]
  organizationId: String
  code: String
  sourceId: String [optional]
  name: String
  description: String
  definition: String
  status: String
  version: String
  reviewStatus: String
  reviewSource: String [optional]
  reviewedBy: String [optional]
  reviewedAt: String [optional]
  moduleOnlyKnowledgeLevels: String[]
  certificateOnlyKnowledgeLevels: String[]
  provisionMode: String [legacy common mode]
  foundationOutcomeLabels: String[] [optional]
  intermediateOutcomeLabels: String[] [optional]
  advancedOutcomeLabels: String[] [optional]
  createdAt: DateTime / String
  updatedAt: DateTime / String
}

class LearningModule {
  id: String [UNIQUE]
  organizationId: String
  title: String
  name: String [legacy alias]
  moduleType: String
  duration: Long
  durationMinutes: Integer [legacy alias]
  knowledgeLevel: String
  skillVersion: String
  contentType: String
  contentUri: String
  contentVersion: String
  version: String
  status: String
  reviewStatus: String
  reviewSource: String [optional]
  reviewedBy: String [optional]
  reviewedAt: String [optional]
}

class Certificate {
  id: String [UNIQUE]
  organizationId: String
  version: String
  name: String
  description: String
  knowledgeLevel: String
  skillVersion: String
  referenceUrl: String
  status: String
  reviewStatus: String
  authoredBy: String
  authoredAt: String
  approvedBy: String
  approvedAt: String
  commandHash: String
}

Department --> JobPosition : HAS_JOB_POSITION
JobPosition --> TargetRole : HAS_ROLE
TargetRole --> Level : HAS_LEVEL
Level --> Competency : HAS_COMPETENCY
Competency --> MicroSkill : HAS_SKILL
Level --> MicroSkill : REQUIRES_SKILL
TargetRole --> MicroSkill : REQUIRES_SKILL [per level]
LearningModule --> MicroSkill : TEACHES
MicroSkill --> MicroSkill : HAS_SKILL_PREREQUISITE
MicroSkill --> Certificate : REQUIRES_CERTIFICATE

note right of JobPosition
  RIASEC: all six integer scores 0..40, or all absent.
  Missing is not zero; six zeros are valid.
  Current profiles are demo/organization values, not O*NET ratings.
  Personal answers/results/AI snapshots belong to PostgreSQL V74.
end note

note bottom of MicroSkill
  Catalog only. PostgreSQL owns learner state and evidence.
  Match Skill + knowledge level + Skill version; no OC filters.
  Each Module teaches one complete Skill at one level.
  TargetRole lifecycle: DRAFT, STAGED, SENT, SUBMITTED,
  REJECTED, PUBLISHED, ACTIVE, UNPUBLISHED, SUPERSEDED.
end note

legend bottom
  Relationship properties (timestamps stored as Neo4j DateTime or ISO-8601 String)
  |= Relationship |= Properties |
  | HAS_JOB_POSITION | id: String; organizationId: String; status: String; version: String; createdAt: String; updatedAt: String |
  | HAS_ROLE / HAS_LEVEL | id: String; organizationId: String; version: String; status: String; reviewStatus: String; createdAt: DateTime/String; updatedAt: DateTime/String |
  | HAS_COMPETENCY / HAS_SKILL | id: String; version: String; status: String; reviewStatus: String |
  | REQUIRES_SKILL (Level -> MicroSkill / TargetRole -> MicroSkill) | id: String; organizationId: String; level: String [on Role edge]; requiredKnowledgeLevels: String[]; isMandatory: Boolean; version: String; status: String; reviewStatus: String; createdAt: DateTime/String; updatedAt: DateTime/String |
  | TEACHES | id: String; organizationId: String; version: String; status: String; reviewStatus: String; reviewSource: String; reviewedBy: String; reviewedAt: String |
  | HAS_SKILL_PREREQUISITE | id: String; organizationId: String; dependentKnowledgeLevel: String; prerequisiteKnowledgeLevel: String; version: String; status: String; reviewStatus: String; reviewSource: String; createdAt: DateTime/String; updatedAt: DateTime/String |
  | REQUIRES_CERTIFICATE | organizationId: String; status: String; createdBy: String; createdAt: String; replacedBy: String [optional]; replacedByActor: String [optional]; replacedAt: String [optional] |
  [UNIQUE] = node ID / composite code uniqueness constraint (V5 JobPosition, V6 Department, Certificate, per-label ID constraints).
endlegend
@enduml
