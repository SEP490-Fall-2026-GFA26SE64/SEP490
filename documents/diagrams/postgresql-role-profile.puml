@startuml
!pragma layout smetana
top to bottom direction
skinparam shadowing false
hide circle
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
title PostgreSQL 17.6 / platform / V1-V26\nCurrent Role selection and initial Occupation profile (3 tables)
legend top left
PK = primary key; FK = foreign-key column; ? = nullable
Arrows: referenced parent -> referencing child; no cardinality inference.
External tables are reference stubs. Full constraints/indexes/triggers: schema catalog.
endlegend
class employee_role_selection {
  selection_id : uuid [PK]
  organization_id : uuid
  learner_id : uuid [FK]
  role_id : text
  occupation_id : text
  role_snapshot : jsonb
  target_revision : bigint
  selected_at : timestamp with time zone
  ended_at? : timestamp with time zone
}
class employee_role_selection_request {
  organization_id : uuid [PK]
  learner_id : uuid [PK]
  retry_key : text [PK]
  request_hash : platform.content_hash
  selection_id : uuid [FK]
  response : jsonb
  created_at : timestamp with time zone
}
class employee_occupation_profile {
  organization_id : uuid [PK, FK]
  learner_id : uuid [PK, FK]
  occupation_id : text [PK, FK]
  attempt_id : uuid [FK]
  blueprint_id : uuid [FK]
  blueprint_version : integer [FK]
  catalog_fingerprint : text
  required_skills : jsonb
  mastery : jsonb
  initialized_at : timestamp with time zone
}
class baseline_adaptive_attempt <<external>> #F1F5F9
class baseline_adaptive_blueprint_version <<external>> #F1F5F9
class learner_state <<external>> #F1F5F9
baseline_adaptive_attempt --> employee_occupation_profile
baseline_adaptive_blueprint_version --> employee_occupation_profile
employee_role_selection --> employee_role_selection_request
learner_state --> employee_role_selection
@enduml
