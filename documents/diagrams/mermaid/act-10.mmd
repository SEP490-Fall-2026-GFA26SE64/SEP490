flowchart TD
    %% Main flow only. Server validates organization/access, ownership, complete content
    %% and current revision. Import validation, successor versions, withdrawal and
    %% availability changes are specified in features/Assessment workflows/README.md.
    START(("Start"))
    CREATE["<b>Responsible Expert</b><br/>Create manually or import questions"]
    DRAFT["<b>System</b><br/>Save as DRAFT"]
    EDIT["<b>Responsible Expert</b><br/>Complete exact Skill, knowledge,<br/>outcome, mandatory flag and four options"]
    SUBMIT["<b>Responsible Expert</b><br/>Submit for review"]
    REVIEW["<b>L&amp;D Manager</b><br/>Review and acknowledge exact version"]
    DECISION{"<b>L&amp;D Manager</b><br/>Approve or Return?"}
    RETURN["<b>System</b><br/>Record feedback and restore DRAFT"]
    PUBLISHED["<b>System</b><br/>Publish immutable version;<br/>retain owned source-bank mapping"]
    END(("End"))

    START --> CREATE --> DRAFT --> EDIT --> SUBMIT --> REVIEW --> DECISION
    DECISION -->|"Return + reason"| RETURN --> EDIT
    DECISION -->|"Approve"| PUBLISHED --> END

    classDef default fill:#ffffff,stroke:#64748b,color:#0f1729,stroke-width:1px,rx:8,ry:8
    classDef decision fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
    classDef success fill:#f0fdf4,stroke:#16a34a,color:#14532d
    classDef entry fill:#c24a0a,stroke:#c24a0a,color:#ffffff,stroke-width:1.5px
    class START,END entry
    class DECISION decision
    class PUBLISHED success
