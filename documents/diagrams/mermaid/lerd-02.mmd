---
erDiagram
  direction TB
  RoleSelection["RoleSelection"] {
    uuid selection_id PK "REQUIRED"
    uuid organization_id FK "REQUIRED"
    uuid learner_id FK "REQUIRED"
    text role_level_id FK "REQUIRED"
    integer revision "REQUIRED"
    timestamptz selected_at "REQUIRED"
    timestamptz ended_at "NULLABLE"
    uuid previous_selection_id FK "NULLABLE"
  }
  BaselineConfigVersion["BaselineConfigVersion"] {
    uuid config_version_id PK "REQUIRED"
    uuid config_id FK "REQUIRED"
    integer version "REQUIRED"
    text name "REQUIRED"
    jsonb parameters "REQUIRED"
    jsonb requirement_snapshot "REQUIRED"
    text content_hash "REQUIRED"
    text availability "REQUIRED"
    uuid activated_by FK "REQUIRED"
    timestamptz activated_at "REQUIRED"
  }
  AssessmentAttempt["AssessmentAttempt"] {
    uuid attempt_id PK "REQUIRED"
    uuid organization_id FK "REQUIRED"
    uuid learner_id FK "REQUIRED"
    uuid selection_id FK "REQUIRED"
    uuid config_version_id FK "NULLABLE"
    uuid progress_id FK "NULLABLE"
    text purpose "REQUIRED"
    jsonb rule_snapshot "REQUIRED"
    jsonb requirement_snapshot "REQUIRED"
    text state "REQUIRED"
    integer revision "REQUIRED"
    timestamptz started_at "REQUIRED"
    timestamptz deadline_at "REQUIRED"
    timestamptz finished_at "NULLABLE"
    text completion_reason "NULLABLE"
    uuid previous_attempt_id FK "NULLABLE"
  }
  AssessmentItem["AssessmentItem"] {
    uuid attempt_id PK, FK "REQUIRED"
    integer position PK "REQUIRED"
    uuid item_version_id FK "REQUIRED"
    text skill_id FK "REQUIRED"
    text knowledge_level "REQUIRED"
    jsonb outcome_codes "REQUIRED"
    jsonb option_order "REQUIRED"
    jsonb scoring_reference "REQUIRED"
  }
  AssessmentAnswer["AssessmentAnswer"] {
    uuid attempt_id PK, FK "REQUIRED"
    integer position PK, FK "REQUIRED"
    jsonb response "REQUIRED"
    boolean is_correct "REQUIRED"
    integer revision "REQUIRED"
    timestamptz accepted_at "REQUIRED"
  }
  QuestionVersion["QuestionVersion"] {
    uuid item_version_id PK "REQUIRED"
    uuid organization_id FK "REQUIRED"
    text skill_id FK "REQUIRED"
    text knowledge_level "REQUIRED"
    text outcome_code "REQUIRED"
    boolean mandatory "REQUIRED"
    text prompt "REQUIRED"
    jsonb options "REQUIRED"
    jsonb scoring_key "REQUIRED"
    text explanation "NULLABLE"
    integer version "REQUIRED"
    text publication_status "REQUIRED"
  }
  SkillResult["SkillResult"] {
    uuid attempt_id PK, FK "REQUIRED"
    text skill_id PK, FK "REQUIRED"
    text knowledge_level PK "REQUIRED"
    jsonb outcome_codes "REQUIRED"
    integer correct_count "REQUIRED"
    integer total_count "REQUIRED"
    boolean valid "REQUIRED"
    text outcome "REQUIRED"
    jsonb reasons "REQUIRED"
    timestamptz finalized_at "REQUIRED"
  }
  CompetencyProfile["CompetencyProfile"] {
    uuid profile_id PK "REQUIRED"
    uuid organization_id FK "REQUIRED"
    uuid learner_id FK "REQUIRED"
    uuid selection_id FK "REQUIRED"
    uuid baseline_attempt_id FK "REQUIRED"
    integer revision "REQUIRED"
    text status "REQUIRED"
    timestamptz created_at "REQUIRED"
    uuid previous_profile_id FK "NULLABLE"
  }
  ProfileSkill["ProfileSkill"] {
    uuid profile_id PK, FK "REQUIRED"
    text skill_id PK, FK "REQUIRED"
    text knowledge_level PK "REQUIRED"
    jsonb outcome_codes "REQUIRED"
    text status "REQUIRED"
    text source_kind "REQUIRED"
    uuid source_attempt_id FK "NULLABLE"
    uuid source_certificate_id FK "NULLABLE"
    timestamptz evaluated_at "REQUIRED"
  }
  RoleSelection ||--o{ AssessmentAttempt : "assessment context"
  BaselineConfigVersion o|--o{ AssessmentAttempt : "baseline version pin"
  AssessmentAttempt ||--|{ AssessmentItem : "freezes paper"
  QuestionVersion ||--o{ AssessmentItem : "published item pin"
  AssessmentItem ||--o| AssessmentAnswer : "accepted response"
  AssessmentAttempt ||--o{ SkillResult : "finalizes"
  RoleSelection ||--o{ CompetencyProfile : "profile history"
  AssessmentAttempt ||--o{ CompetencyProfile : "valid baseline source"
  CompetencyProfile ||--|{ ProfileSkill : "outcomes"
