---
stateDiagram-v2
  state "Job Position profile lifecycle (derived)" as Group0 {
    state "No profile" as noProfile
    state "Initialized profile" as profileReady
    [*] --> noProfile
    noProfile --> noProfile : Invalidated baseline: no profile is created
    noProfile --> profileReady : SUBMITTED or AUTO_SUBMITTED; complete valid skill results
    profileReady --> profileReady : Read or replay: keep the existing profile
  }
  state "Skill evidence for a gap evaluation" as Group1 {
    state "KNOWN<br/>valid mastery result" as known
    state "UNKNOWN<br/>no usable result" as unknown
    state evidenceCheck <<choice>>
    [*] --> evidenceCheck
    evidenceCheck --> known : yes
    evidenceCheck --> unknown : no
  }
  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class profileReady accepted
  class known accepted
