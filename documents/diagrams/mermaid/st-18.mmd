---
stateDiagram-v2
  state "Profile revision (physical<br/>foundation)" as SDD_ST_18_Profile {
    state "PENDING" as SDD_ST_18_PENDING
    state "COMPLETE" as SDD_ST_18_COMPLETE
    state "BLOCKED" as SDD_ST_18_BLOCKED
    [*] --> SDD_ST_18_PENDING
    SDD_ST_18_PENDING --> SDD_ST_18_COMPLETE : coherent valid evidence/model application
    SDD_ST_18_PENDING --> SDD_ST_18_BLOCKED : unresolved required input
    SDD_ST_18_BLOCKED --> SDD_ST_18_PENDING : approved retry with source identity
  }
  state "Skill evidence quality" as SDD_ST_18_Evidence {
    state "UNKNOWN" as SDD_ST_18_UNKNOWN
    state "PROVISIONAL" as SDD_ST_18_PROVISIONAL
    state "OBJECTIVE" as SDD_ST_18_OBJECTIVE
    [*] --> SDD_ST_18_UNKNOWN
    SDD_ST_18_UNKNOWN --> SDD_ST_18_PROVISIONAL : permitted provisional evidence
    SDD_ST_18_UNKNOWN --> SDD_ST_18_OBJECTIVE : accepted objective evidence
    SDD_ST_18_PROVISIONAL --> SDD_ST_18_OBJECTIVE : accepted objective evidence
  }

  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  class SDD_ST_18_COMPLETE accepted

  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  class SDD_ST_18_BLOCKED attention

  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class SDD_ST_18_PENDING working
