---

stateDiagram-v2
  direction TB
  state "Baseline diagnostic projection" as Diagnostic {
    state "Not assessed" as unknown
    state "Passed diagnostic" as passed
    state "Learning need" as need
    unknown --> passed : Assessed target group passes
    unknown --> need : Assessed target group fails
  }
  state "Official evidence" as Official {
    state "No compatible evidence" as absent
    state "ACHIEVED evidence retained" as achieved
    absent --> achieved : Qualifying module plus assessment or approved certificate
    achieved --> achieved : Preserve append-only accepted sources
  }
  state "Prerequisite review flag" as Review {
    state "NEED_REVIEW" as flagged
    state "RESOLVED" as resolved
    [*] --> flagged : Already-achieved prerequisite later fails
    flagged --> resolved : Compatible later official evidence
  }
  note right of Diagnostic
    Never creates official achievement
    Never invents unassessed prerequisite results
  end note
  note right of Review
    Review does not revoke achievement
    Bypass does not create evidence
  end note
