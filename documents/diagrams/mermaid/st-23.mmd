stateDiagram-v2
  state "NotStarted" as SDD_ST_23_NotStarted
  state "Learning" as SDD_ST_23_Learning
  state "ReadyForAssessment" as SDD_ST_23_Ready
  state "Assessing" as SDD_ST_23_Assessing
  state "EvidenceRecorded" as SDD_ST_23_Evidence
  state "ProgressUpdated" as SDD_ST_23_Progress
  [*] --> SDD_ST_23_NotStarted
  SDD_ST_23_NotStarted --> SDD_ST_23_Learning : start permitted module
  SDD_ST_23_Learning --> SDD_ST_23_Learning : study / save / resume
  SDD_ST_23_Learning --> SDD_ST_23_Ready : content conditions satisfied
  SDD_ST_23_Ready --> SDD_ST_23_Assessing : assessment admitted
  SDD_ST_23_Assessing --> SDD_ST_23_Evidence : exact qualifying assessment and completion
  SDD_ST_23_Evidence --> SDD_ST_23_Progress : update independent progress
  SDD_ST_23_Progress --> SDD_ST_23_Learning : continue independent study
  SDD_ST_23_Progress --> [*] : finish session

  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  class SDD_ST_23_Learning,SDD_ST_23_Ready,SDD_ST_23_Assessing working
  class SDD_ST_23_Evidence,SDD_ST_23_Progress accepted

  note right of SDD_ST_23_NotStarted
    Independent learning remains a partial target
    Rule exam requires exact accepted option and completion context
  end note
