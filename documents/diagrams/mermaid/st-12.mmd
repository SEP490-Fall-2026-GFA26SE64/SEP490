stateDiagram-v2
  state "Review status" as SDD_ST_12_Review {
    state "NEEDS_EXPERT_REVIEW" as SDD_ST_12_NEEDS_EXPERT_REVIEW
    state "APPROVED" as SDD_ST_12_APPROVED
    state "REJECTED" as SDD_ST_12_REJECTED
