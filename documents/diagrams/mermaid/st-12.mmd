    SDD_ST_12_NEEDS_EXPERT_REVIEW --> SDD_ST_12_REJECTED : actual Expert decision
  }
  state "Catalog lifecycle vocabulary" as SDD_ST_12_Lifecycle {
    state "DRAFT" as SDD_ST_12_DRAFT
    state "ACTIVE" as SDD_ST_12_ACTIVE
    state "ARCHIVED" as SDD_ST_12_ARCHIVED
