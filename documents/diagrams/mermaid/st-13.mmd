---
stateDiagram-v2
  direction TB
  state "Working configuration" as Draft {
    state "OPEN" as open
    state "FINALIZED" as finalized
    state "ABANDONED" as abandoned
    [*] --> open : L&D selects Role and Level
    open --> open : Save parameters or correct validation errors
    open --> finalized : Validate and activate matching Role-Level configuration
    open --> abandoned : Explicit L&D discard
  }
  state "Released Role-Level version" as Version {
    state "Active" as active
    state "Retiring" as retiring
    state "Inactive" as inactive
    active --> retiring : Replace or disable, pinned attempt still in progress
    active --> inactive : Replace or disable, no attempt in progress
    retiring --> inactive : Last pinned attempt finalizes
  }
  finalized --> active : Save immutable version and active pointer atomically
  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class open working
  class finalized,active accepted
