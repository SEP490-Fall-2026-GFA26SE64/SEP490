stateDiagram-v2
  state "Working revision (persisted)" as SDD_ST_13_Working {
    state "OPEN" as SDD_ST_13_OPEN
    state "FINALIZED" as SDD_ST_13_FINALIZED
    state "ABANDONED" as SDD_ST_13_ABANDONED
    [*] --> SDD_ST_13_OPEN
    SDD_ST_13_OPEN --> SDD_ST_13_OPEN : revision-checked save / no-op receipt
    SDD_ST_13_OPEN --> SDD_ST_13_FINALIZED : successful activation
    SDD_ST_13_OPEN --> SDD_ST_13_ABANDONED : explicit confirmed discard
  }
  state "Released version (derived<br/>availability)" as SDD_ST_13_Released {
    state "Active" as SDD_ST_13_Active
    state "Retiring" as SDD_ST_13_Retiring
    state "Inactive" as SDD_ST_13_Inactive
    [*] --> SDD_ST_13_Active : current activation pointer
    SDD_ST_13_Active --> SDD_ST_13_Retiring : pointer replaced/disabled, pinned<br/>IN_PROGRESS exists
    SDD_ST_13_Active --> SDD_ST_13_Inactive : pointer replaced/disabled, no IN_PROGRESS
    SDD_ST_13_Retiring --> SDD_ST_13_Inactive : last pinned attempt genuinely finalized
  }

  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class SDD_ST_13_OPEN,SDD_ST_13_Active working
