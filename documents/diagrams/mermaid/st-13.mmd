---

stateDiagram-v2
  direction TB
  state "Scoped policy workspace" as Scope {
    state "No draft" as none
    state "Mutable draft" as draft
    state "Abandoned snapshot" as abandoned
    none --> draft : Authorized owner creates draft
    draft --> draft : Save with revision and catalog hash
    draft --> none : Publish immutable version and consume draft
    draft --> abandoned : L&D abandons saved baseline draft
    abandoned --> none : Preserve history
  }
  state "Scoped activation" as Active {
    state "No active policy" as absent
    state "Active immutable version" as active
    [*] --> absent
    absent --> active : Publish first complete ready policy
    active --> active : Replace pointer with next scoped version
  }
  note right of Scope
    L&D owns Role plus member Level BASELINE
    Expert owns Skill plus knowledge SKILL_ASSESSMENT
  end note
  note right of Active
    Draft may coexist with active policy
    Pinned attempts retain original version
  end note
