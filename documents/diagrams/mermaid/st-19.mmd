stateDiagram-v2
  direction TB
  state "PENDING" as pending
  state "GENERATING" as generating
  state "AWAITING_EXPERT_REVIEW" as review
  state "FAILED_RETRYABLE" as retry
  state "BLOCKED_OR_UNRESOLVED" as blocked
  state "APPROVED" as approved
  state "LEARNING" as learning
  state "COMPLETED" as completed
  state "BYPASS_ONLY<br/>Needs supplementation remains" as bypass
  [*] --> pending : Confirm reviewed profile request
  pending --> generating : Freeze Role-Level input
  generating --> completed : No learning required
  generating --> review : Proposal and provision check
  generating --> retry : Transient generation failure
  generating --> blocked : Planning error
  retry --> generating : Retry within allowed policy
  blocked --> generating : Repair and retry
  review --> review : Expert edits or repairs proposal
  review --> approved : Expert approves exact valid revision
  approved --> learning : Non-bypassed requirements remain
  approved --> bypass : Only accepted bypasses remain
  learning --> learning : Assess and recalculate
  learning --> review : New missing provision
  learning --> completed : All required work met
  learning --> bypass : Only accepted bypasses remain
  completed --> [*] : Permit target change
  bypass --> [*] : Permit change, preserve gaps
  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class pending,generating,review,learning working
  class approved,completed accepted
  class blocked attention
  class bypass working
