---

stateDiagram-v2
  direction TB
  state "Request generation status" as Request {
    state "PENDING" as pending
    state "GENERATING" as generating
    state "FAILED_RETRYABLE" as failed
    state "SUCCEEDED" as ready
    state "NO_LEARNING_REQUIRED" as empty
    [*] --> pending : Freeze requirement input and bind target
    pending --> generating : Worker claim and fencing
    generating --> failed : Recoverable generation failure
    failed --> generating : Authorized repair and retry
    generating --> ready : Publish required-work revision
    generating --> empty : No required learning need
  }
  state "Review status" as Review {
    state "AWAITING_EXPERT_REVIEW" as waiting
    state "APPROVED" as approved
    [*] --> waiting : Required work needs initial review
    waiting --> approved : Assigned Expert approves exact revision and hash
    approved --> approved : Valid successor keeps approval basis
    approved --> waiting : Approval assignment or basis no longer valid
  }
  state "Requirement step state" as Step {
    state "NEEDS_EXPERT_ACTION" as action
    state "NEEDS_SUPPLEMENTATION" as needs
    state "IN_PROGRESS" as studying
    state "FULFILLED" as fulfilled
    state "BYPASSED" as bypassed
    action --> needs : Compatible provision appears
    needs --> studying : Start accepted option
    studying --> fulfilled : Exact official evidence accepted
    action --> bypassed : Authorized scoped decision with reason
    needs --> bypassed : Source permits unresolved REQUIRED waiver
    studying --> bypassed : Source permits unresolved REQUIRED waiver
  }
  note right of Step
    PARALLEL_SUPPLEMENT never gates new target
    No blocking REQUIRED steps releases target
    Bypass policy boundary remains unresolved
  end note
