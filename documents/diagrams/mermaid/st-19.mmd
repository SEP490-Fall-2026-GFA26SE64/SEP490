---
stateDiagram-v2
  state "Pathway Request: Generation Status" as Group0 {
    state "PENDING" as pending
    state "GENERATING" as generating
    state "SUCCEEDED" as success
    state "NO_LEARNING_REQUIRED" as noLearn
    state "UNRESOLVED" as unresolved
    state "BLOCKED" as blocked
    state "FAILED_RETRYABLE" as retry
    state "STALE" as stale
    [*] --> pending : explicit confirmation
    pending --> generating : System starts processing
    generating --> success : Valid pathway found; search completed
    generating --> noLearn : no mandatory need
    generating --> unresolved : infeasible / cycle / search limit, not proved
    generating --> blocked : missing configuration / invalid input / retry exhausted
    generating --> retry : transient failure; attempts remain
    retry --> generating : backoff + System starts processing
    retry --> blocked : Retry limit reached
    generating --> stale : Source or selection changed
  }
  state "Pathway Request: Review and Validation" as Group1 {
    state "AWAITING_EXPERT_REVIEW<br/>validation = VALID" as valid
    state "AWAITING_EXPERT_REVIEW<br/>validation = UNRESOLVED" as invalidDraft
    state "APPROVED<br/>exact revision + content hash" as approved
    state "NONE<br/>no current proposal" as none
    valid --> invalidDraft : save edit with uncovered need
    invalidDraft --> valid : save eligible repair; fixed set validates
    valid --> approved : assigned Expert confirms the reviewed valid version
    [*] --> none
    none --> valid : Initial pathway generated; first revision saved
  }
  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class pending working
  class generating working
  class success accepted
  class blocked attention
  class approved accepted
