sequenceDiagram
  autonumber
  actor SDD_SEQ_02_User as User
  participant SDD_SEQ_02_UI as Login UI
  participant SDD_SEQ_02_API as WorkspaceAuthenticationController
  participant SDD_SEQ_02_Auth as WorkspaceAuthenticationService
  participant SDD_SEQ_02_DB as Identity / registration<br/>stores
  participant SDD_SEQ_02_Guard as Entitlement / assignment<br/>guard
  SDD_SEQ_02_User->>SDD_SEQ_02_UI: email and password
  SDD_SEQ_02_UI->>SDD_SEQ_02_API: sign in
  SDD_SEQ_02_API->>SDD_SEQ_02_Auth: signIn(...)
