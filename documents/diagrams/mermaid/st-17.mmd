stateDiagram-v2
  direction TB
  state "No selection" as none
  state "Current target<br/>Baseline or profile" as selected
  state "Current target<br/>Pathway pending or learning" as locked
  state "Current target<br/>Change allowed" as eligible
  state "Historical selection" as history
  [*] --> none
  none --> selected : Confirm available Role and member Level
  selected --> selected : Same target or resume
  selected --> locked : Submit pathway request
  locked --> eligible : Pathway completed OR only accepted missing-provision bypasses remain
  eligible --> eligible : Keep target
  eligible --> history : Replace pair, no active attempt
  history --> selected : New selection, require baseline
  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class selected,locked working
  class eligible accepted
