stateDiagram-v2
  direction TB
  state "Persisted attempt" as Attempt {
    state "IN_PROGRESS" as progress
    state "FINALIZED" as finalized
    [*] --> progress : Freeze complete paper and deadline
    progress --> progress : Answer or resume before deadline
    progress --> finalized : Accepted submit or server deadline
  }
  state "Downstream processing" as Processing {
    state "PENDING" as pending
    state "PROCESSED" as processed
    [*] --> pending : Finalized event creates recoverable work
    pending --> pending : Retry or wait for required supplement
    pending --> processed : Idempotent effects and receipt
  }
  note right of finalized
    finishReason SUBMITTED or DEADLINE
    Wrong and unanswered count zero
    Each group has passed and veto results
  end note
  note right of processed
    Baseline gives diagnostics only
    Official evidence requires exact completion or
    certificate
  end note
