stateDiagram-v2
  state "EMAIL_PENDING" as SDD_ST_01_EMAIL_PENDING
  state "MFA_PENDING" as SDD_ST_01_MFA_PENDING
  state "REGISTERED" as SDD_ST_01_REGISTERED
  [*] --> SDD_ST_01_EMAIL_PENDING : successful atomic registration
  SDD_ST_01_EMAIL_PENDING --> SDD_ST_01_MFA_PENDING : valid email proof consumed
  SDD_ST_01_MFA_PENDING --> SDD_ST_01_REGISTERED : authenticator enrollment completed
  SDD_ST_01_EMAIL_PENDING --> SDD_ST_01_EMAIL_PENDING : resend / resume / rejected proof
  SDD_ST_01_MFA_PENDING --> SDD_ST_01_MFA_PENDING : retry or resume enrollment
  SDD_ST_01_REGISTERED --> SDD_ST_01_REGISTERED : authenticated resume

  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  class SDD_ST_01_REGISTERED accepted
