---
stateDiagram-v2
  state "PENDING" as SDD_ST_22_PENDING {
    state "Due" as SDD_ST_22_DUE
    state "Leased" as SDD_ST_22_LEASED
    [*] --> SDD_ST_22_DUE
    SDD_ST_22_DUE --> SDD_ST_22_LEASED : worker claim when due<br/>(attempts + 1, 5-minute lease)
    SDD_ST_22_LEASED --> SDD_ST_22_DUE : retryable failure, attempts below 5<br/>(backoff) / lease expired
  }
  state "SUCCEEDED" as SDD_ST_22_SUCCEEDED
  state "FAILED" as SDD_ST_22_FAILED
  [*] --> SDD_ST_22_PENDING : first payment applied with<br/>a saved catalog selection
  SDD_ST_22_PENDING --> SDD_ST_22_SUCCEEDED : copy committed by lease owner<br/>/ workspace PROVISIONING to READY
  SDD_ST_22_PENDING --> SDD_ST_22_FAILED : selection invalid / 5th attempt failed<br/>/ workspace PROVISIONING to FAILED
  SDD_ST_22_SUCCEEDED --> [*]
  SDD_ST_22_FAILED --> [*]

  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  class SDD_ST_22_SUCCEEDED accepted
  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  class SDD_ST_22_FAILED attention
  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class SDD_ST_22_DUE,SDD_ST_22_LEASED working