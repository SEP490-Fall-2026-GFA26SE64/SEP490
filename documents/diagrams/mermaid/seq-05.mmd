sequenceDiagram
  autonumber
  actor SDD_SEQ_05_LD as L and D Manager
  actor SDD_SEQ_05_Expert as Expert
  participant SDD_SEQ_05_Workflow as Role workflow
  participant SDD_SEQ_05_Guard as Trusted assignment guard
  participant SDD_SEQ_05_DB as Workflow persistence
  participant SDD_SEQ_05_Graph as Catalog projection
  SDD_SEQ_05_LD->>SDD_SEQ_05_Workflow: create role and assign Expert
  SDD_SEQ_05_Workflow->>SDD_SEQ_05_Guard: authorize organization and assignment
