---
title: "SEQ-05 - Target Role Handoff - Current Low-Level Calls"
config:
  theme: base
  fontFamily: "Arial, sans-serif"
  themeVariables: {background: "#ffffff", primaryColor: "#ffffff", primaryTextColor: "#0f172a", lineColor: "#64748b", actorBkg: "#fff5eb", actorBorder: "#ea580c", actorTextColor: "#0f172a", signalColor: "#64748b", signalTextColor: "#0f172a"}
  sequence: {actorMargin: 35, messageMargin: 32, mirrorActors: false, wrap: true, width: 180}
---
sequenceDiagram
  autonumber
  actor LD as L&D Manager
  actor Expert as Expert
  participant UI as TargetRolesPage / ExpertAssignedRolesPage
  participant Ctrl as OrganizationTargetRoleController
  participant App as OrganizationTargetRoleApplicationService
  participant Svc as TargetRoleService
  participant Repo as Neo4jTargetRoleRepository
  participant Graph as Neo4jClient / Neo4j

  LD->>UI: Create role and assign Expert
  UI->>Ctrl: POST organization target-roles, CreateTargetRoleRequest
  Ctrl->>App: createTargetRole(organizationId, request)
  App->>Svc: createTargetRole(CreateTargetRoleCommand)
  Svc->>Repo: existsByOrganizationIdAndCodeAndVersion(org, code, version)
  Repo-->>Svc: exists
  alt duplicate identity
    Svc-->>Ctrl: DuplicateTargetRoleException
    Ctrl-->>UI: 409 Conflict
  else new role
    Svc->>Svc: TargetRole.createNew(command)
    Svc->>Repo: save(targetRole)
    Repo->>Graph: Merge role and synchronize catalog relationships
    Repo-->>Svc: TargetRole
    Ctrl-->>UI: 201 Created
  end

  loop Save configuration, submit or record L&D decision
    alt Expert configuration or submission
      Expert->>UI: Save configuration or handleSubmitToManager
      UI->>Ctrl: PUT roleId, configuration or status SUBMITTED
    else L&D approval or rejection
      LD->>UI: handleApproveAndPublishRole / handleConfirmManagerRejection
      UI->>Ctrl: PUT roleId, status ACTIVE or REJECTED with reason
    end
    Ctrl->>App: getTargetRole(organizationId, roleId)
    App-->>Ctrl: Existing role and assignedExpertId
    Ctrl->>Ctrl: role-header checks, assignment comparison when userId supplied
    alt denied or Expert role missing
      Ctrl-->>UI: 403 Forbidden or 404 Not Found
    else allowed request
      Ctrl->>App: updateTargetRole(org, roleId, UpdateTargetRoleRequest)
      App->>Svc: updateTargetRole(UpdateTargetRoleCommand)
      Svc->>Repo: findById(org, roleId)
      Repo-->>Svc: Existing TargetRole
        Svc->>Svc: TargetRole.updateDetails(command fields)
        Svc->>Repo: save(updated)
        Repo->>Graph: Merge role, sync relationships, supersede if published
        Repo-->>Svc: updated TargetRole
        Ctrl-->>UI: 200 OK
    end
  end
