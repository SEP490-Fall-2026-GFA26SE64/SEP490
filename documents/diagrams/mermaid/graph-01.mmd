  SDD_GRAPH_01_MicroSkill }o--o{ SDD_GRAPH_01_MicroSkill : "HAS_SKILL_PREREQUISITE"
  SDD_GRAPH_01_Certificate }o--|| SDD_GRAPH_01_MicroSkill : "CERTIFIES"
