%% Companion of ../neo4j.puml; canonical image exports use that PlantUML source.
classDiagram
  direction TB
  class JobPosition {
    id: String [UNIQUE]
    code: String
    name: String
    organizationId: String
    version: String
    status: String
    reviewStatus: String
    jobZone: Long
    interestRealistic: Double
    interestInvestigative: Double
    interestArtistic: Double
    interestSocial: Double
    interestEnterprising: Double
    interestConventional: Double
  }
  class TargetRole {
    id: String [UNIQUE]
    code: String
    name: String
    organizationId: String
    version: String
    status: String
    reviewStatus: String
    scope: String
    assignedExpertId: String
    assignedExpertName: String
  }
  class Level {
    id: String [UNIQUE]
    code: String
    name: String
    organizationId: String
    version: String
    status: String
    reviewStatus: String
    rank: Long
    attainmentRule: String
  }
  class Competency {
    id: String [UNIQUE]
    code: String
    name: String
    description: String
    organizationId: String
    version: String
    status: String
    reviewStatus: String
    attainmentRule: String
  }
  class MicroSkill {
    id: String [UNIQUE]
    name: String
    definition: String
    organizationId: String
    version: String
    status: String
    reviewStatus: String
    reviewSource: String
    reviewedBy: String
    provisionMode: String
    foundationOutcomeCodes: String[]
    foundationOutcomeLabels: String[]
    intermediateOutcomeCodes: String[]
    intermediateOutcomeLabels: String[]
    advancedOutcomeCodes: String[]
    advancedOutcomeLabels: String[]
  }
  class LearningModule {
    id: String [UNIQUE]
    title: String
    organizationId: String
    version: String
    status: String
    reviewStatus: String
    reviewSource: String
    moduleType: String
    duration: Long
    knowledgeLevel: String
    skillVersion: String
    contentType: String
    contentUri: String
    contentVersion: String
    outcomeCodes: String[]
  }
  class Certificate {
    id: String [UNIQUE]
    organizationId: String
    version: String
    name: String
    description: String
    knowledgeLevel: String
    skillVersion: String
    outcomeCodes: String[]
    referenceUrl: String
    status: String
    reviewStatus: String
    authoredBy: String
    authoredAt: String
    approvedBy: String
    approvedAt: String
    commandHash: String
  }
  JobPosition --> TargetRole : HAS_ROLE
  TargetRole --> Level : HAS_LEVEL
  Level --> Competency : HAS_COMPETENCY
  Competency --> MicroSkill : HAS_SKILL
  Level --> MicroSkill : REQUIRES_SKILL
  LearningModule --> MicroSkill : TEACHES
  MicroSkill --> MicroSkill : HAS_SKILL_PREREQUISITE
  MicroSkill --> Certificate : REQUIRES_CERTIFICATE
  note for MicroSkill "Catalog only. PostgreSQL owns learner state and evidence."
  note for Certificate "Source-defined; not observed in supplied schema capture."
