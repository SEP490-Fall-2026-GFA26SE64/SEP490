erDiagram
  direction LR
  SDD_GRAPH_01_JobPosition["JobPosition"] {
    string id PK
    string code
    string name
    integer jobZone
    number interestRealistic
    number interestInvestigative
    number interestArtistic
    number interestSocial
    number interestEnterprising
    number interestConventional
  }
  SDD_GRAPH_01_TargetRole["TargetRole"] {
    string id PK
    string code
    string name
    string scope
    string rejectReason
  }
  SDD_GRAPH_01_Level["Level"] {
    string id PK
    string code
    string name
    integer rank
    review_estimate duration
    string attainmentRule
  }
  SDD_GRAPH_01_Competency["Competency"] {
    string id PK
    string code
    string name
    string description
    string attainmentRule
  }
  SDD_GRAPH_01_MicroSkill["MicroSkill"] {
    string id PK
    string name
    string definition
  }
  SDD_GRAPH_01_LearningModule["LearningModule"] {
    string id PK
    string title
    string moduleType
    string contentUri
    string contentType
    string contentVersion
    review_estimate duration
    review_estimate price
  }
  SDD_GRAPH_01_Certificate["Certificate"] {
    string id PK
    string organizationId
    string name
    string knowledgeLevel
    json outcomeCodes
    string referenceUrl
  }
