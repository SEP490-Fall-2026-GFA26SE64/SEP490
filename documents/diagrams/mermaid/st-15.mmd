stateDiagram-v2
  state "Calibration run" as SDD_ST_15_Run {
    state "PENDING" as SDD_ST_15_PENDING
    state "RUNNING" as SDD_ST_15_RUNNING
    state "SUCCEEDED" as SDD_ST_15_SUCCEEDED
    state "FAILED" as SDD_ST_15_FAILED
    [*] --> SDD_ST_15_PENDING
    SDD_ST_15_PENDING --> SDD_ST_15_RUNNING : worker starts actual calibration
    SDD_ST_15_RUNNING --> SDD_ST_15_SUCCEEDED : valid output parameter set
    SDD_ST_15_RUNNING --> SDD_ST_15_FAILED : recorded calibration failure
  }
  state "Parameter set" as SDD_ST_15_Parameters {
    state "BUILDING" as SDD_ST_15_BUILDING
    state "CANDIDATE" as SDD_ST_15_CANDIDATE
    state "PROMOTED" as SDD_ST_15_PROMOTED
    [*] --> SDD_ST_15_BUILDING
    SDD_ST_15_BUILDING --> SDD_ST_15_CANDIDATE : parameter construction completed
    SDD_ST_15_CANDIDATE --> SDD_ST_15_PROMOTED : authorized scoped promotion
  }

  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  class SDD_ST_15_SUCCEEDED,SDD_ST_15_PROMOTED accepted

  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  class SDD_ST_15_FAILED attention

  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class SDD_ST_15_PENDING,SDD_ST_15_RUNNING working
