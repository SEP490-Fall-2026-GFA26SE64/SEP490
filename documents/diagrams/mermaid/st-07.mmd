stateDiagram-v2
  state "Workspace setup" as SDD_ST_07_Setup {
    state "PROVISIONING" as SDD_ST_07_PROVISIONING
    state "READY" as SDD_ST_07_READY
    state "FAILED" as SDD_ST_07_FAILED
    [*] --> SDD_ST_07_PROVISIONING
    SDD_ST_07_PROVISIONING --> SDD_ST_07_READY : setup transaction without starter catalog<br/>/ starter catalog copy succeeded
    SDD_ST_07_PROVISIONING --> SDD_ST_07_FAILED : catalog copy failed after final attempt<br/>(CATALOG_IMPORT_FAILED)
    SDD_ST_07_FAILED --> SDD_ST_07_PROVISIONING : approved recoverable retry<br/>(target, not implemented)
  }
  state "Organization administrative<br/>state" as SDD_ST_07_Organization {
    state "ACTIVE" as SDD_ST_07_ACTIVE
    state "SUSPENDED" as SDD_ST_07_SUSPENDED
    [*] --> SDD_ST_07_ACTIVE
    SDD_ST_07_ACTIVE --> SDD_ST_07_SUSPENDED : authorized platform action
    SDD_ST_07_SUSPENDED --> SDD_ST_07_ACTIVE : authorized reactivation
  }

  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
