---
title: "Frontend Package Overview"
config:
  layout: elk
  look: classic
  theme: base
  fontFamily: "Arial, sans-serif"
  themeVariables: {background: "#ffffff", primaryColor: "#ffffff", primaryTextColor: "#0f172a", primaryBorderColor: "#334155", lineColor: "#334155", edgeLabelBackground: "#ffffff", fontSize: "16px"}
  themeCSS: ".node rect, .cluster rect { filter: none !important; stroke-width: 1.5px !important; }"
  flowchart: {htmlLabels: true, nodeSpacing: 28, rankSpacing: 55, padding: 16, diagramPadding: 24, curve: linear}
---
flowchart LR
  subgraph FrontendRoot["frontend/src"]
    App["app"]
    Features["features"]
    Shared["shared"]
    Assets["assets"]
  end
  App -.-> Features
  App -.-> Shared
  Features -.-> Shared

  classDef default fill:#fff7ed,stroke:#d97706,color:#0f172a,stroke-width:1.5px
  style FrontendRoot fill:#eff6ff,stroke:#2563eb,color:#0f172a
