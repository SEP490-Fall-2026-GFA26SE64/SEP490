---
stateDiagram-v2
  state "Question authoring version" as Group0 {
    state "DRAFT" as qd
    state "SUBMITTED" as qsub
    state "PUBLISHED" as qpub
    [*] --> qd
    qd --> qsub : Expert submits for review
    qsub --> qd : Expert withdraws or L and D Manager returns
    qsub --> qpub : L and D Manager reviews and approves the submitted version
  }
  state "Stored assessment version" as Group1 {
    state "DRAFT" as ad
    state "PUBLISHED" as ap
    [*] --> ad
    ad --> ap : Authorized review and publication
  }
  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class qd working
  class qsub working
  class qpub accepted
  class ad working
  class ap accepted
