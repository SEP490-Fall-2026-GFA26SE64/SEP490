---
stateDiagram-v2
  state "Payment application" as SDD_ST_06_Application {
    state "PENDING" as SDD_ST_06_PENDING
    state "WAITING_CAPACITY" as SDD_ST_06_WAITING_CAPACITY
    state "APPLIED" as SDD_ST_06_APPLIED
    state "EXCEPTION" as SDD_ST_06_EXCEPTION
    [*] --> SDD_ST_06_PENDING
    SDD_ST_06_PENDING --> SDD_ST_06_WAITING_CAPACITY : paid renewal exceeds chosen seats
    SDD_ST_06_WAITING_CAPACITY --> SDD_ST_06_APPLIED : capacity remediated and rechecked
    SDD_ST_06_PENDING --> SDD_ST_06_APPLIED : valid unique application
    SDD_ST_06_PENDING --> SDD_ST_06_EXCEPTION : inconsistent application prerequisites
    SDD_ST_06_APPLIED --> [*]
  }
  state "Intent (separate aggregate)" as SDD_ST_06_Intent {
    state "OPEN" as SDD_ST_06_OPEN
    state "APPLYING" as SDD_ST_06_APPLYING
    [*] --> SDD_ST_06_OPEN
    SDD_ST_06_OPEN --> SDD_ST_06_APPLYING : verified paid order selected
    SDD_ST_06_APPLYING --> SDD_ST_06_IntentWaiting : capacity blocked
    state "WAITING_CAPACITY" as SDD_ST_06_IntentWaiting
    SDD_ST_06_IntentWaiting --> SDD_ST_06_IntentApplied : remediation and apply
    SDD_ST_06_APPLYING --> SDD_ST_06_IntentApplied : apply succeeds
    state "APPLIED" as SDD_ST_06_IntentApplied
    SDD_ST_06_APPLYING --> SDD_ST_06_IntentException : application exception
    state "EXCEPTION" as SDD_ST_06_IntentException
  }

  classDef accepted fill:#eaf6ef,stroke:#1a9e4a,color:#0f1729,stroke-width:1.5px
  class SDD_ST_06_APPLIED,SDD_ST_06_IntentApplied accepted

  classDef attention fill:#fdf2f2,stroke:#dc2828,color:#0f1729,stroke-width:1.5px
  class SDD_ST_06_EXCEPTION,SDD_ST_06_IntentException attention

  classDef working fill:#fef3eb,stroke:#e6650f,color:#0f1729,stroke-width:1.5px
  class SDD_ST_06_PENDING,SDD_ST_06_OPEN working
