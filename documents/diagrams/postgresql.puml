@startuml
!pragma layout smetana
top to bottom direction
skinparam shadowing false
title PostgreSQL - Identity, catalog and processing
class organization {
    organization_id : uuid [PK]
    code : text
    name : text
    status : text
    created_at : timestamp with time zone
}
class organizational_unit {
    unit_id : uuid [PK]
    parent_unit_id? : uuid [FK]
    name : text
    organization_id? : uuid [FK]
}
class account {
    account_id : uuid [PK]
    unit_id? : uuid [FK]
    identifier : text
    normalized_identifier : text
    password_hash : text
    active : boolean
    created_at : timestamp with time zone
    organization_id? : uuid [FK]
}
class application_role {
    role_code : text [PK]
}
class account_role {
    account_id : uuid [PK, FK]
    role_code : text [PK, FK]
}
class manager_scope {
    manager_id : uuid [PK, FK]
    unit_id : uuid [PK, FK]
}
class session {
    session_id : uuid [PK]
    account_id : uuid [FK]
    token_hash : platform.content_hash
    created_at : timestamp with time zone
    expires_at : timestamp with time zone
    revoked_at? : timestamp with time zone
}
class organization_registration {
    registration_id : uuid [PK]
    account_id : uuid [FK]
    organization_name : character varying(200)
    workspace_slug : character varying(63)
    industry? : text
    headcount? : text
    admin_name : character varying(120)
    state : text
    email_verified_at? : timestamp with time zone
    completed_at? : timestamp with time zone
    auth_version : bigint
    recovery_required : boolean
    created_at : timestamp with time zone
    updated_at : timestamp with time zone
}
class registration_email_verification {
    account_id : uuid [PK, FK]
    code_hmac : platform.content_hash
    generation : bigint
    expires_at : timestamp with time zone
    consumed_at? : timestamp with time zone
    last_sent_at : timestamp with time zone
    window_started_at : timestamp with time zone
    sends_in_window : integer
}
class account_totp {
    account_id : uuid [PK, FK]
    encrypted_secret : text
    enabled_at : timestamp with time zone
    last_used_step : bigint
}
class account_recovery_code {
    account_id : uuid [PK, FK]
    code_hash : platform.content_hash [PK]
    created_at : timestamp with time zone
    consumed_at? : timestamp with time zone
}
class registration_rate_limit {
    bucket_key : platform.content_hash [PK]
    window_started_at : timestamp with time zone
    attempts : integer
    blocked_until? : timestamp with time zone
}
class registration_session {
    primary_id : character(36) [PK]
    session_id : character(36)
    creation_time : bigint
    last_access_time : bigint
    max_inactive_interval : integer
    expiry_time : bigint
    principal_name? : character varying(100)
}
class registration_session_attributes {
    session_primary_id : character(36) [PK, FK]
    attribute_name : character varying(200) [PK]
    attribute_bytes : bytea
}
class learner_state {
    learner_id : uuid [PK, FK]
    submission_sequence : bigint
    profile_revision : bigint
    progress_revision : bigint
    target_revision : bigint
}
class catalog_guard {
    guard_id : integer [PK]
    state : text
    intent_id? : uuid
    release_id? : uuid
    source_revision : bigint
    availability_revision : bigint
    manifest_hash? : platform.content_hash
    updated_at : timestamp with time zone
}
class catalog_release {
    release_id : uuid [PK]
    source_revision : bigint
    manifest_hash : platform.content_hash
    source_event_id : uuid
    confirmed_at : timestamp with time zone
}
class catalog_reference {
    catalog_ref_id : uuid [PK]
    entity_id : uuid
    version_id : uuid
    release_id : uuid [FK]
    kind : text
    source_hash : platform.content_hash
    confirmed_at : timestamp with time zone
}
class target_selection {
    selection_id : uuid [PK]
    learner_id : uuid [FK]
    role_ref_id : uuid [FK]
    role_kind : text [FK]
    selected_at : timestamp with time zone
    ended_at? : timestamp with time zone
    role_snapshot? : jsonb
}
class target_selection_request {
    request_id : uuid [PK]
    actor_id : uuid [FK]
    operation : text
    idempotency_key : text
    request_hash : platform.content_hash
    status : text
    result_selection_id? : uuid [FK]
    result_target_revision? : bigint
    result_changed? : boolean
    outcome_code? : text
    created_at : timestamp with time zone
    completed_at? : timestamp with time zone
}
class outbox_event {
    event_id : uuid [PK]
    event_type : text
    aggregate_id : uuid
    source_revision : bigint
    payload : jsonb
    correlation_id : uuid
    created_at : timestamp with time zone
    delivered_at? : timestamp with time zone
}
class processing_job {
    job_id : uuid [PK]
    event_id : uuid [FK]
    handler : text
    learner_id? : uuid [FK]
    submission_sequence? : bigint
    predecessor_job_id? : uuid [FK]
    status : text
    lease_owner? : text
    lease_expires_at? : timestamp with time zone
    attempts : integer
    next_retry_at : timestamp with time zone
    failure_code? : text
    created_at : timestamp with time zone
}
class processing_receipt {
    event_id : uuid [PK]
    handler : text [PK]
    source_revision : bigint
    applied_at : timestamp with time zone
}
class audit_event {
    audit_event_id : uuid [PK]
    actor_id? : uuid [FK]
    service_name? : text
    action : text
    resource_id : uuid
    resource_revision? : text
    occurred_at : timestamp with time zone
    outcome : text
    correlation_id : uuid
}
account --> account_role
account --> account_totp
account --> audit_event
account --> learner_state
account --> manager_scope
account --> organization_registration
account --> session
account --> target_selection_request
account_totp --> account_recovery_code
application_role --> account_role
catalog_reference --> target_selection
catalog_release --> catalog_reference
learner_state --> processing_job
learner_state --> target_selection
organization --> account
organization --> organizational_unit
organization_registration --> registration_email_verification
organizational_unit --> account
organizational_unit --> manager_scope
organizational_unit --> organizational_unit
outbox_event --> processing_job
processing_job --> processing_job
registration_session --> registration_session_attributes
target_selection --> target_selection_request
@enduml
