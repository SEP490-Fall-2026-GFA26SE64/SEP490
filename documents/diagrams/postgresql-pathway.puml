@startuml
!pragma layout smetana
top to bottom direction
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
title Requirement pathway and certificate - selected source-defined columns
entity "pathway_requirement_snapshot" as pathway_requirement_snapshot {
  uuid id <<PK>>
  uuid organization_id
  uuid learner_id
  uuid selection_id
  bigint selection_revision
  content_hash content_hash
}
entity "initial_pathway_request" as initial_pathway_request {
  uuid request_id <<PK>>
  uuid organization_id
  uuid learner_id
  uuid selection_id
  uuid requirement_snapshot_id "NULLABLE"
  text flow_version "NULLABLE"
  text generation_status
}
entity "initial_pathway_revision" as initial_pathway_revision {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  content_hash content_hash
  text change_origin "NULLABLE"
  bigint approval_basis_revision "NULLABLE"
}
entity "pathway_requirement_step" as pathway_requirement_step {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  uuid step_id <<PK>>
  text skill_id
  text knowledge_level
  text kind
  text state
  uuid source_bypass_id "NULLABLE"
  uuid fulfilled_evidence_id "NULLABLE"
}
entity "pathway_requirement_option" as pathway_requirement_option {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  uuid step_id <<PK>>
  text module_id <<PK>>
  text content_version <<PK>>
  integer module_revision
}
entity "pathway_requirement_dependency" as pathway_requirement_dependency {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  uuid prerequisite_step_id <<PK>>
  uuid dependent_step_id <<PK>>
  jsonb assessed_source
}
entity "pathway_requirement_bypass" as pathway_requirement_bypass {
  uuid id <<PK>>
  uuid request_id
  bigint revision
  uuid step_id
  uuid expert_id
  text reason
}
entity "certificate_submission" as certificate_submission {
  uuid id <<PK>>
  uuid organization_id
  uuid learner_id
  text definition_id
  text definition_version
  bigint revision
  text status
  jsonb definition_snapshot
}
entity "certificate_submission_attachment" as certificate_submission_attachment {
  uuid submission_id <<PK>>
  text evidence_kind
  text private_object_key "NULLABLE"
  text https_url "NULLABLE"
}
entity "certificate_submission_decision" as certificate_submission_decision {
  uuid id <<PK>>
  uuid submission_id
  bigint submission_revision
  uuid expert_id
  text decision
  text reason
}
pathway_requirement_snapshot --> initial_pathway_request : owned input FK
initial_pathway_request --> initial_pathway_revision : retained revisions
initial_pathway_revision --> pathway_requirement_step : same owned revision FK
pathway_requirement_step --> pathway_requirement_option : same request revision step
pathway_requirement_step --> pathway_requirement_dependency : prerequisite and dependent FKs
pathway_requirement_step --> pathway_requirement_bypass : authorized source decision
certificate_submission --> certificate_submission_attachment : one evidence form FK
certificate_submission --> certificate_submission_decision : same submission revision owner FK
note bottom of certificate_submission : Request and step context is frozen JSON, not an invented SQL FK.
@enduml
