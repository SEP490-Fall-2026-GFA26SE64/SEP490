@startuml
!pragma layout smetana
top to bottom direction
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
title Requirement pathway, timing and certificate - selected workspace source through V82 / 2026-11-23
entity "pathway_requirement_snapshot" as pathway_requirement_snapshot {
  uuid id <<PK>>
  uuid organization_id
  uuid learner_id
  uuid selection_id
  bigint selection_revision
  content_hash content_hash
  jsonb snapshot
}
entity "initial_pathway_request" as initial_pathway_request {
  uuid request_id <<PK>>
  uuid organization_id
  uuid learner_id
  uuid selection_id
  uuid requirement_snapshot_id "NULLABLE"
  text flow_version
  text generation_status
  bigint selection_revision
  jsonb frozen_input
}
entity "initial_pathway_revision" as initial_pathway_revision {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  content_hash content_hash
  text change_origin
  bigint approval_basis_revision "NULLABLE"
  uuid source_event_id "NULLABLE"
  jsonb content
}
entity "pathway_requirement_step" as pathway_requirement_step {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  uuid step_id <<PK>>
  text skill_id
  text knowledge_level
  text kind
  text state
  uuid source_bypass_id "NULLABLE"
  uuid fulfilled_evidence_id "NULLABLE"
  jsonb requirement_snapshot
  text provision
  integer ordinal
  text reason
  text certificate_id "NULLABLE"
  text certificate_version "NULLABLE"
}
entity "pathway_requirement_option" as pathway_requirement_option {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  uuid step_id <<PK>>
  text module_id <<PK>>
  text content_version <<PK>>
  integer module_revision
}
entity "pathway_requirement_dependency" as pathway_requirement_dependency {
  uuid request_id <<PK>>
  bigint revision <<PK>>
  uuid prerequisite_step_id <<PK>>
  uuid dependent_step_id <<PK>>
  jsonb assessed_source
}
entity "pathway_requirement_bypass" as pathway_requirement_bypass {
  uuid id <<PK>>
  uuid request_id
  bigint revision
  uuid step_id
  uuid expert_id
  text reason
  uuid organization_id
  uuid learner_id
  jsonb assignment_snapshot
  uuid retry_key
  timestamptz decided_at
}
entity "certificate_submission" as certificate_submission {
  uuid id <<PK>>
  uuid organization_id
  uuid learner_id
  text definition_id
  text definition_version
  bigint revision
  text status
  jsonb definition_snapshot
  uuid replaces_submission_id "NULLABLE"
}
entity "certificate_submission_attachment" as certificate_submission_attachment {
  uuid submission_id <<PK>>
  text evidence_kind
  text private_object_key "NULLABLE"
  text https_url "NULLABLE"
}
entity "certificate_submission_decision" as certificate_submission_decision {
  uuid id <<PK>>
  uuid submission_id
  bigint submission_revision
  uuid expert_id
  text decision
  text reason
}
pathway_requirement_snapshot --> initial_pathway_request : owned input FK
initial_pathway_request --> initial_pathway_revision : retained revisions
initial_pathway_revision --> pathway_requirement_step : same owned revision FK
pathway_requirement_step --> pathway_requirement_option : same request revision step
pathway_requirement_step --> pathway_requirement_dependency : prerequisite and dependent FKs
pathway_requirement_step --> pathway_requirement_bypass : authorized source decision
certificate_submission --> certificate_submission_attachment : one evidence form FK
certificate_submission --> certificate_submission_decision : same submission revision owner FK
note bottom of certificate_submission : Request and step context is frozen JSON, not an invented SQL FK.
entity "initial_pathway_current" as initial_pathway_current {
  uuid request_id <<PK, FK>>
  uuid organization_id
  uuid learner_id
  uuid selection_id
  bigint selection_revision
  bigint current_revision "NULLABLE"
  text review_status "includes REJECTED"
  timestamptz archived_at "NULLABLE"
  integer timing_duration_months "NULLABLE"
  jsonb timing_basis "NULLABLE"
  timestamptz timing_started_at "NULLABLE"
  timestamptz timing_deadline_at "NULLABLE"
  timestamptz timing_completed_at "NULLABLE"
  boolean timing_on_time "NULLABLE"
}
entity "initial_pathway_approval" as initial_pathway_approval {
  uuid request_id <<PK, FK>>
  bigint revision <<PK, FK>>
  content_hash content_hash
  uuid expert_id
  text assignment_id
  text assignment_version
  timestamptz confirmed_at
}
entity "learning_notification" as learning_notification {
  uuid id <<PK>>
  text organization_id
  text recipient_id
  text event_key
  text kind
  text module_id "NULLABLE after V64"
  text deep_link "NULLABLE"
  timestamptz toast_observed_at "NULLABLE"
  timestamptz created_at
}
initial_pathway_request --> initial_pathway_current : owned request FK
initial_pathway_revision --> initial_pathway_current : nullable current revision FK
initial_pathway_revision --> initial_pathway_approval : exact revision hash owner FKs
initial_pathway_revision --> initial_pathway_revision : nullable approval_basis_revision FK
note bottom of initial_pathway_current
  First real approval pins positive calendar months in UTC.
  Six timing columns; later revisions cannot restart the clock.
  Historical approvals stay untimed; completion facts are immutable.
end note
note bottom of learning_notification
  Separate text-keyed notification owner, not a SQL FK to pathway.
  V80-V82 allow explicit Employee, assigned-Expert and L&D review deep links.
  Dedup recipient/event; toast observation differs from read state.
end note
legend bottom
  Selected columns through V82; not a complete or live schema capture.
  Parent -> child = physical FK; edges may summarize composite ownership.
  Certificate request/step references and notification deep links are JSON/text, NOT cross-store FKs.
  Immutable revision/change_origin/source_event/approval basis preserve recalculation history.
endlegend
entity "certificate_authoring" as certificate_authoring {
  uuid id <<PK>>
  uuid organization_id
  uuid author_id
  bigint revision
  text skill_id
  text knowledge_level
  text skill_name
  jsonb input
  text state
  uuid reviewer_id "NULLABLE"
  text reason
  text definition_id "NULLABLE"
  timestamptz created_at
  timestamptz updated_at
  integer attempts
  timestamptz next_attempt
}
entity "certificate_authoring_batch" as certificate_authoring_batch {
  uuid organization_id <<PK>>
  uuid actor_id <<PK>>
  uuid key <<PK>>
  text hash
  jsonb ids
}
entity "certificate_authoring_view" as certificate_authoring_view {
  uuid organization_id
  uuid draft_id <<PK, FK>>
  bigint revision <<PK>>
  uuid reviewer_id <<PK>>
  timestamptz viewed_at
}
entity "certificate_authoring_event" as certificate_authoring_event {
  uuid id <<PK>>
  uuid organization_id
  uuid draft_id <<FK>>
  bigint revision
  uuid actor_id
  text action
  jsonb snapshot
  timestamptz occurred_at
}
certificate_authoring --> certificate_authoring_view : exact draft FK; revision review acknowledgement
certificate_authoring --> certificate_authoring_event : retained authoring event FK
note bottom of certificate_authoring_batch
  ids JSON is an idempotent batch receipt, not a physical draft FK.
end note
@enduml
