@startuml
!pragma layout smetana
left to right direction
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
title Ontology r3 - existing topology, explicit knowledge requirements - TARGET, not applied
class "JobPosition / TargetRole" as jp {
  Existing HAS_ROLE relationship
  Existing IDs / ownership / review
  Role owns its member Levels
}
class "Level" as lv {
  Existing HAS_LEVEL relationship
  Member Level is not knowledgeLevel
  REQUIRES_SKILL: explicit level list
}
class "Competency" as co {
  HAS_COMPETENCY / HAS_SKILL kept
  Existing grouping and metadata
  No independent numeric mastery
}
class "MicroSkill" as ms {
  Existing identity / tenant / review
  moduleOnlyKnowledgeLevels [list]
  certificateOnlyKnowledgeLevels [list]
  Disjoint modes for each skill-level
  foundation/intermediate/advanced
  OutcomeCodes [native scalar lists]
  No extra requirement node
}
class "LearningModule" as mo {
  Existing content / version / metadata
  knowledgeLevel: one fixed enum value
  outcomeCodes: exact coverage
  TEACHES exactly one MicroSkill
  Multiple equivalent alternatives
  No teachingFocus / difficultyLevel
  No level copy on TEACHES
}
class "Certificate" as ce {
  id / org / version / lifecycle
  knowledgeLevel / outcomeCodes
  name / description / referenceUrl
  HTTPS reference URL required
  One assigned per certificate-only level
  Definition, not Employee evidence
}
class "Relationship properties (annotation)" as pr {
  REQUIRES_SKILL.requiredKnowledgeLevels replaces score
  HAS_SKILL_PREREQUISITE: dependent/prerequisite levels
  No implicit inheritance or speculative baseline closure
}
jp --> lv : HAS_LEVEL
lv --> co : grouping
lv --> ms : REQUIRES_SKILL
co --> ms : HAS_SKILL
mo --> ms : TEACHES
ms --> ce : REQUIRES_CERTIFICATE
ms --> ms : HAS_SKILL_PREREQUISITE
ms --> pr : exact level pairs
@enduml