  "organizationId" varchar [null, note: 'Optional source-defined organization ownership; not a PostgreSQL FK.']
  "sourceId" varchar [null, note: 'Optional provenance added when a template is copied into an organization.']
  Note: 'Directed Neo4j relationship Occupation -[HAS_ROLE]-> TargetRole. Endpoints and synthetic key exist only for dbdiagram visualization.'
}

Ref REL_HAS_ROLE_from: relationships.REL_HAS_ROLE."_from_node_id" > nodes.Occupation."id"
Ref REL_HAS_ROLE_to: relationships.REL_HAS_ROLE."_to_node_id" > nodes.TargetRole."id"

