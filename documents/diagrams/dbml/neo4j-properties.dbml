}

Table relationships.REL_HAS_ROLE {
  "_diagram_key" bigint [pk, note: 'Diagram-only synthetic key; not a graph property or persisted identity.']
  "_from_node_id" varchar [not null, note: 'Diagram-only start endpoint: Occupation. Not a stored property.']
  "_to_node_id" varchar [not null, note: 'Diagram-only end endpoint: TargetRole. Not a stored property.']
  "id" varchar [null]
  "version" varchar [null, note: 'Catalog metadata property retained; no separate Version node is introduced.']
  "status" varchar [null]
  "reviewStatus" varchar [null]
