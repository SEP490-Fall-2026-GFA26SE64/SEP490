  "code" varchar [null]
  "name" varchar [null]
  "scope" varchar [null]
  "occupationId" varchar [null, note: 'Source-path dependent: omitted by the standalone graph_payload importer, preserved/remapped by the workspace template-copy writer. Ownership is also represented by graph relationships.']
  "organizationId" varchar [null, note: 'Optional source-defined organization ownership; not a PostgreSQL FK.']
  "sourceId" varchar [null, note: 'Optional provenance added when a template is copied into an organization.']
  "sourceTemplateVersion" varchar [null, note: 'Optional template provenance on copied nodes.']
  "baseCode" varchar [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "familyCode" varchar [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "track" varchar [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "assignedExpertId" varchar [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "description" text [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "responsibilities" "string[]" [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "skillTargets" text [null, note: 'JSON-serialized skill-target structure.']
  "levels" "string[]" [null, note: 'Runtime TargetRole levels list; distinct from the Level node label.']
  "levelCompetencies" text [null, note: 'JSON-serialized competency structure.']
  "competencyIds" "string[]" [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "createdAt" datetime [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "updatedAt" datetime [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  "rejectionReason" text [null, note: 'Optional property supported by runtime authoring/reader source; not present on every catalog node.']
  Note: 'Neo4j node label TargetRole. Properties are not relational columns; optional source extensions may not exist on an individual node.'
}

