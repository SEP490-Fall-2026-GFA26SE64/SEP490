// HISTORICAL source-union projection, superseded for the current catalog diagram on 2026-11-08.
// Current canonical graph: ../neo4j.puml; capture/source scope: ../../neo4j_schema.md#diagram-scope--2026-11-08.
// Retained as a separate historical relational visualization; do not use it as the current capture.
// Paste this complete file into dbdiagram.io. This is a VISUAL relational projection of Neo4j.
// It is NOT a PostgreSQL migration or a physical Neo4j table schema.
// Evidence: documents/neo4j_schema.md, ontology_seed-v011.json and graph_payload.py;
// runtime source: Neo4jWorkspaceCatalogWriter, Neo4j*Repository and JdbcModuleAuthoringAdapter.
// No running Neo4j was inspected. Properties are the union of documented catalog and explicit source extensions.
// Six primary node labels plus the source-supported legacy MacroCompetency label are shown separately.
// Neo4j properties are optional unless specifically constrained. Absent review fields are not fabricated.
// Each REL_* block is a directed graph relationship with its own properties, NOT a real join table.
// _from_node_id, _to_node_id and _diagram_key are diagram-only fields, never Neo4j properties.
// Relationship ids are not universally present in legacy runtime writes, so they are not forced to be PK/not-null.
// Version metadata properties remain because only version TABLES were excluded, not entity properties.

Project AdaptLearnGraph_Neo4j {
  database_type: 'Neo4j'
  Note: 'Visualization only: node/relationship property contract plus source-supported authoring extensions. Not a live graph inventory and not a relational database design.'
}

Table nodes.Occupation {
  "id" varchar [pk, not null]
  "version" varchar [null, note: 'Catalog metadata property retained; no separate Version node is introduced.']
  "status" varchar [null]
  "reviewStatus" varchar [null]
  "reviewedBy" varchar [null, note: 'May be absent until a genuine review is recorded.']
  "reviewedAt" varchar [null, note: 'May be absent; documented seed uses ISO-8601 text. Some runtime paths use temporal values.']
  "code" varchar [null]
  "name" varchar [null]
  "jobZone" integer [null]
  "interestRealistic" float [null]
  "interestInvestigative" float [null]
  "interestArtistic" float [null]
  "interestSocial" float [null]
  "interestEnterprising" float [null]
  "interestConventional" float [null]
  "organizationId" varchar [null, note: 'Optional source-defined organization ownership; not a PostgreSQL FK.']
  "sourceId" varchar [null, note: 'Optional provenance added when a template is copied into an organization.']
  "sourceTemplateVersion" varchar [null, note: 'Optional template provenance on copied nodes.']
  Note: 'Neo4j node label Occupation. Properties are not relational columns; optional source extensions may not exist on an individual node.'
}

Table nodes.TargetRole {
  "id" varchar [pk, not null]
