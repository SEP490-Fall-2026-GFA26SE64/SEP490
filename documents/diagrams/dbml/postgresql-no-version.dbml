Table platform.workspace_activation {
  "activation_id" uuid [not null, pk]
  "organization_id" uuid [not null]
  "created_by" uuid [not null]
  "full_name" "character varying(120)" [not null]
  "email" "character varying(254)" [not null]
  "roles" "text[]" [not null]
  "department_id" uuid [null]
  "occupation_reference_id" uuid [null]
  "proof_hash" "platform.content_hash" [not null, unique, note: 'Domain base type: text. Domain constraints: CHECK ((VALUE ~ \'^[0-9a-f]{64}$\'::text))']
  "generation" bigint [not null]
  "expires_at" "timestamp with time zone" [not null]
  "created_at" "timestamp with time zone" [not null]
  "last_sent_at" "timestamp with time zone" [not null]
  "consumed_at" "timestamp with time zone" [null]
  "account_id" uuid [null]

  Note: 'pending_activation_single_role: CHECK (((consumed_at IS NOT NULL) OR (cardinality(roles) = 1)))\nworkspace_activation_check: CHECK (((occupation_reference_id IS NULL) OR (department_id IS NOT NULL)))\nworkspace_activation_check1: CHECK (((NOT (\'EMPLOYEE\'::text = ANY (roles))) OR ((department_id IS NOT NULL) AND (occupation_reference_id IS NOT NULL))))\nworkspace_activation_check2: CHECK (((consumed_at IS NULL) = (account_id IS NULL)))\nworkspace_activation_check3: CHECK ((expires_at = (last_sent_at + \'00:10:00\'::interval)))\nworkspace_activation_email_check: CHECK ((((email)::text = lower(btrim((email)::text))) AND ((email)::text <> \'\'::text)))\nworkspace_activation_full_name_check: CHECK ((btrim((full_name)::text) <> \'\'::text))\nworkspace_activation_generation_check: CHECK ((generation > 0))\nworkspace_activation_roles_check: CHECK (((cardinality(roles) > 0) AND (array_position(roles, NULL::text) IS NULL) AND (roles <@ ARRAY[\'EMPLOYEE\'::text, \'DOMAIN_EXPERT\'::text, \'LD_MANAGER\'::text, \'ORGANIZATION_ADMINISTRATOR\'::text])))\nIndex: CREATE UNIQUE INDEX workspace_activation_pkey ON platform.workspace_activation USING btree (activation_id)\nIndex: CREATE UNIQUE INDEX workspace_activation_proof_hash_key ON platform.workspace_activation USING btree (proof_hash)\nIndex: CREATE UNIQUE INDEX workspace_pending_activation_email_idx ON platform.workspace_activation USING btree (email) WHERE (consumed_at IS NULL)'
}

Table platform.workspace_baseline_resource {
  "organization_id" uuid [not null]
  "occupation_reference_id" uuid [null, note: 'Non-null retains department-reference grant/activation checks; null is a baseline-owned binding whose active catalog ownership is revalidated against trusted organization context. Created only by explicit L&D resource configuration.']
