  "question_bank_id" uuid [null]
  "model_version_id" uuid [null, note: 'FK target hidden intentionally: platform.model_version (model_version_id); constraint workspace_baseline_resource_model_version_id_fkey']
  "mastery_mapping_version_id" uuid [null, note: 'FK target hidden intentionally: platform.mastery_mapping_version (mastery_mapping_version_id); constraint workspace_baseline_resource_mastery_mapping_version_id_fkey']

  indexes {
    ("organization_id", "graph_occupation_id") [pk, name: 'workspace_baseline_resource_pkey']
    ("organization_id", "occupation_reference_id") [unique, name: 'workspace_baseline_resource_organization_id_occupation_refe_key']
  }

  Note: 'Explicit tenant catalog grant and baseline resource binding. Null pins are unconfigured; integration never publishes or seeds content.\nworkspace_baseline_resource_graph_occupation_id_check: CHECK (((graph_occupation_id <> \'\'::text) AND (graph_occupation_id = btrim(graph_occupation_id))))\nIndex: CREATE UNIQUE INDEX workspace_baseline_resource_pkey ON platform.workspace_baseline_resource USING btree (organization_id, graph_occupation_id)\nIndex: CREATE UNIQUE INDEX workspace_baseline_resource_organization_id_occupation_refe_key ON platform.workspace_baseline_resource USING btree (organization_id, occupation_reference_id)\nHIDDEN TARGET - workspace_baseline_resource_mastery_mapping_version_id_fkey: FOREIGN KEY (mastery_mapping_version_id) REFERENCES platform.mastery_mapping_version(mastery_mapping_version_id)\nHIDDEN TARGET - workspace_baseline_resource_model_version_id_fkey: FOREIGN KEY (model_version_id) REFERENCES platform.model_version(model_version_id)'
}

Table platform.workspace_catalog_import {
  "organization_id" uuid [not null, pk]
  "registration_id" uuid [not null, unique]
  "state" text [not null]
  "attempts" integer [not null, note: 'Default expression: 0']
  "next_attempt_at" "timestamp with time zone" [not null]
  "lease_owner" uuid [null]
  "lease_until" "timestamp with time zone" [null]
  "template_version" text [null]
  "template_sha256" text [null]
  "node_count" integer [null]
  "relationship_count" integer [null]
  "failure_code" text [null]
  "created_at" "timestamp with time zone" [not null]
  "updated_at" "timestamp with time zone" [not null]
  "completed_at" "timestamp with time zone" [null]

  Note: 'workspace_catalog_import_attempts_check: CHECK ((attempts >= 0))\nworkspace_catalog_import_check: CHECK (((state = \'SUCCEEDED\'::text) = (completed_at IS NOT NULL)))\nworkspace_catalog_import_node_count_check: CHECK (((node_count IS NULL) OR (node_count >= 0)))\nworkspace_catalog_import_relationship_count_check: CHECK (((relationship_count IS NULL) OR (relationship_count >= 0)))\nworkspace_catalog_import_state_check: CHECK ((state = ANY (ARRAY[\'PENDING\'::text, \'SUCCEEDED\'::text, \'FAILED\'::text])))\nworkspace_catalog_import_template_sha256_check: CHECK (((template_sha256 IS NULL) OR (template_sha256 ~ \'^[0-9a-f]{64}$\'::text)))\nIndex: CREATE UNIQUE INDEX workspace_catalog_import_pkey ON platform.workspace_catalog_import USING btree (organization_id)\nIndex: CREATE UNIQUE INDEX workspace_catalog_import_registration_id_key ON platform.workspace_catalog_import USING btree (registration_id)\nIndex: CREATE INDEX workspace_catalog_import_due ON platform.workspace_catalog_import USING btree (next_attempt_at) WHERE (state = \'PENDING\'::text)'
}

