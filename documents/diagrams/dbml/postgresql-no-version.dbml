_id) WHERE (coverage_role = \'COVERAGE\'::text)\nHIDDEN TARGET - initial_pathway_teaching_v2_request_id_revision_format_ver_fkey: FOREIGN KEY (request_id, revision, format_version) REFERENCES platform.initial_pathway_revision(request_id, revision, format_version)\nHIDDEN TARGET - initial_pathway_teaching_v2_request_id_revision_organizati_fkey: FOREIGN KEY (request_id, revision, organization_id, learner_id, selection_id, selection_revision) REFERENCES platform.initial_pathway_revision(request_id, revision, organization_id, learner_id, selection_id, selection_revision)'
