  Note: 'assessment_policy_pin_shape: CHECK ((((assessment_policy_mode IS NULL) AND (assessment_policy_version_id IS NULL) AND (assessment_policy_hash IS NULL) AND (assessment_policy_snapshot IS NULL)) OR ((assessment_policy_mode IS NOT NULL) AND (assessment_policy_mode = \'ORG_POLICY_V1\'::text) AND (assessment_policy_version_id IS NOT NULL) AND (assessment_policy_hash IS NOT NULL) AND (assessment_policy_snapshot IS NOT NULL) AND (jsonb_typeof(assessment_policy_snapshot) = \'object\'::text))))\nbaseline_adaptive_attempt_attempt_id_check: CHECK ((attempt_id <> \'00000000-0000-0000-0000-000000000000\'::uuid))\nbaseline_adaptive_attempt_attempt_purpose_check: CHECK ((attempt_purpose = ANY (ARRAY[\'ROLE_REQUIREMENT\'::text, \'OCCUPATION_EXPLORATION\'::text])))\nbaseline_adaptive_attempt_catalog_fingerprint_check: CHECK ((btrim(catalog_fingerprint) <> \'\'::text))\nbaseline_adaptive_attempt_check: CHECK ((((attempt_purpose = \'ROLE_REQUIREMENT\'::text) AND (target_role_id IS NOT NULL)) OR ((attempt_purpose = \'OCCUPATION_EXPLORATION\'::text) AND (target_role_id IS NULL) AND (target_selection_revision IS NULL))))\nbaseline_adaptive_attempt_check1: CHECK ((deadline_at = (started_at + ((time_limit_seconds)::double precision * \'00:00:01\'::interval))))\nbaseline_adaptive_attempt_check2: CHECK ((isfinite(started_at) AND isfinite(deadline_at)))\nbaseline_adaptive_attempt_check3: CHECK (((replaces_attempt_id IS NULL) OR (replaces_attempt_id <> attempt_id)))\nbaseline_adaptive_attempt_max_questions_check: CHECK ((max_questions > 0))\nbaseline_adaptive_attempt_occupation_id_check: CHECK (((occupation_id <> \'\'::text) AND (occupation_id = btrim(occupation_id))))\nbaseline_adaptive_attempt_revision_check: CHECK ((revision > 0))\nbaseline_adaptive_attempt_scope_policy_check: CHECK (((scope_policy IS NULL) OR (scope_policy = \'FULL_OCCUPATION_V2\'::text)))\nbaseline_adaptive_attempt_state_check: CHECK ((state = ANY (ARRAY[\'IN_PROGRESS\'::text, \'SUBMITTED\'::text, \'AUTO_SUBMITTED\'::text, \'INVALIDATED\'::text])))\nbaseline_adaptive_attempt_target_selection_revision_check: CHECK ((target_selection_revision > 0))\nbaseline_adaptive_attempt_terminal_check: CHECK ((((state = \'IN_PROGRESS\'::text) AND (finished_at IS NULL) AND (completion_reason IS NULL)) OR ((finished_at IS NOT NULL) AND (completion_reason IS NOT NULL) AND isfinite(finished_at) AND (finished_at >= started_at) AND (((state = \'SUBMITTED\'::text) AND (completion_reason = \'MANUAL\'::text) AND (finished_at < deadline_at)) OR ((state = \'AUTO_SUBMITTED\'::text) AND (((completion_reason = \'ADAPTIVE_STOP\'::text) AND (finished_at < deadline_at)) OR ((completion_reason = \'DEADLINE\'::text) AND (finished_at >= deadline_at)))) OR ((state = \'INVALIDATED\'::text) AND ((completion_reason = \'TECHNICAL_FAILURE\'::text) OR ((completion_reason = \'MANUAL\'::text) AND (finished_at < deadline_at)) OR ((completion_reason = \'DEADLINE\'::text) AND (finished_at >= deadline_at))))))))\nbaseline_adaptive_attempt_time_limit_seconds_check: CHECK ((time_limit_seconds > 0))\nIndex: CREATE UNIQUE INDEX baseline_adaptive_attempt_pkey ON platform.baseline_adaptive_attempt USING btree (attempt_id)\nIndex: CREATE UNIQUE INDEX baseline_adaptive_attempt_replaces_attempt_id_key ON platform.baseline_adaptive_attempt USING btree (replaces_attempt_id)\nIndex: CREATE UNIQUE INDEX baseline_adaptive_attempt_attempt_id_organization_id_key ON platform.baseline_adaptive_attempt USING btree (attempt_id, organization_id)\nIndex: CREATE UNIQUE INDEX baseline_adaptive_attempt_attempt_id_organization_id_learne_key ON platform.baseline_adaptive_attempt USING btree (attempt_id, organization_id, learner_id, occupation_id)\nIndex: CREATE UNIQUE INDEX baseline_adaptive_attempt_attempt_id_parameter_set_id_key ON platform.baseline_adaptive_attempt USING btree (attempt_id, parameter_set_id)\nIndex: CREATE UNIQUE INDEX baseline_attempt_one_active_idx ON platform.baseline_adaptive_attempt USING btree (organization_id, learner_id, occupation_id) WHERE (state = \'IN_PROGRESS\'::text)\nIndex: CREATE UNIQUE INDEX baseline_attempt_one_success_idx ON platform.baseline_adaptive_attempt USING btree (organization_id, learner_id, occupation_id) WHERE (state = ANY (ARRAY[\'SUBMITTED\'::text, \'AUTO_SUBMITTED\'::text]))\nIndex: CREATE UNIQUE INDEX baseline_attempt_one_root_idx ON platform.baseline_adaptive_attempt USING btree (organization_id, learner_id, occupation_id) WHERE (replaces_attempt_id IS NULL)\nIndex: CREATE INDEX baseline_attempt_deadline_idx ON platform.baseline_adaptive_attempt USING btree (deadline_at, attempt_id) WHERE (state = \'IN_PROGRESS\'::text)\nIndex: CREATE INDEX baseline_attempt_history_idx ON platform.baseline_adaptive_attempt USING btree (organization_id, learner_id, occupation_id, started_at DESC, attempt_id)\nIndex: CREATE INDEX baseline_attempt_blueprint_idx ON platform.baseline_adaptive_attempt USING btree (blueprint_id, blueprint_version)\nIndex: CREATE INDEX baseline_occupation_retiring_idx ON platform.baseline_adaptive_attempt USING btree (organization_id, blueprint_id, blueprint_version) WHERE (state = \'IN_PROGRESS\'::text)\nHIDDEN TARGET - assessment_policy_own_pin: FOREIGN KEY (organization_id, assessment_policy_version_id) REFERENCES platform.baseline_assessment_policy_version(organization_id, policy_version_id)\nHIDDEN TARGET - baseline_adaptive_attempt_organization_id_occupation_id_bl_fkey: FOREIGN KEY (organization_id, occupation_id, blueprint_id, blueprint_version) REFERENCES platform.baseline_adaptive_blueprint_version(organization_id, occupation_id, blueprint_id, version)\nadaptive_attempt_complete: DEFERRABLE; initially deferred: true'
}

