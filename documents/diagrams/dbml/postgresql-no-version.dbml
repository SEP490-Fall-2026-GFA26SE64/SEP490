  "attempt" integer [not null]
  "provider_order_code" bigint [not null, unique, note: 'Default expression: nextval(\'platform.payos_order_code_seq\'::regclass)']
  "plan_id" uuid [not null, note: 'FK target hidden intentionally: platform.subscription_plan_version (plan_id, version_id); constraint payment_order_plan_id_plan_version_id_fkey']
  "plan_version_id" uuid [not null, note: 'FK target hidden intentionally: platform.subscription_plan_version (plan_id, version_id); constraint payment_order_plan_id_plan_version_id_fkey']
  "name" text [not null]
  "description" text [not null]
  "price_vnd" bigint [not null]
  "currency" "character varying(3)" [not null]
  "duration_months" integer [not null]
  "employee_seats" integer [not null]
  "idempotency_key" uuid [not null]
  "request_digest" "platform.content_hash" [not null, note: 'Domain base type: text. Domain constraints: CHECK ((VALUE ~ \'^[0-9a-f]{64}$\'::text))']
  "payment_status" text [not null, note: 'Default expression: \'CREATING\'::text']
  "provider_status" text [null]
  "payment_link_id" text [null, unique]
  "checkout_url" text [null]
  "observed_paid_amount" bigint [null]
  "paid_at" "timestamp with time zone" [null]
  "last_checked_at" "timestamp with time zone" [null]
  "failure_code" text [null]
  "supersedes_order_id" uuid [null]
  "revision" bigint [not null, note: 'Default expression: 0']
  "created_at" "timestamp with time zone" [not null]
  "expires_at" "timestamp with time zone" [not null]
  "development_bypassed_at" "timestamp with time zone" [null]

  indexes {
    ("created_by", "idempotency_key") [unique, name: 'payment_order_created_by_idempotency_key_key']
    ("intent_id", "attempt") [unique, name: 'payment_order_intent_id_attempt_key']
    ("intent_id", "order_id") [unique, name: 'payment_order_intent_id_order_id_key']
  }

  Note: 'payment_development_bypass_truth: CHECK ((((payment_status = \'DEV_BYPASSED\'::text) = (development_bypassed_at IS NOT NULL)) AND ((payment_status <> \'DEV_BYPASSED\'::text) OR ((observed_paid_amount IS NULL) AND (paid_at IS NULL) AND (payment_link_id IS NULL) AND (checkout_url IS NULL) AND (provider_status IS NULL)))))\npayment_order_attempt_check: CHECK ((attempt > 0))\npayment_order_check: CHECK ((expires_at = (created_at + \'00:30:00\'::interval)))\npayment_order_check1: CHECK ((supersedes_order_id IS DISTINCT FROM order_id))\npayment_order_check2: CHECK (((payment_status <> \'UNPAID_TERMINAL\'::text) OR ((observed_paid_amount IS NOT NULL) AND (observed_paid_amount = 0))))\npayment_order_check3: CHECK (((payment_status <> \'PAID\'::text) OR ((observed_paid_amount IS NOT NULL) AND (observed_paid_amount = price_vnd) AND (paid_at IS NOT NULL))))\npayment_order_currency_check: CHECK (((currency)::text = \'VND\'::text))\npayment_order_description_check: CHECK ((btrim(description) <> \'\'::text))\npayment_order_duration_months_check: CHECK ((duration_months > 0))\npayment_order_employee_seats_check: CHECK ((employee_seats > 0))\npayment_order_name_check: CHECK ((btrim(name) <> \'\'::text))\npayment_order_observed_paid_amount_check: CHECK ((observed_paid_amount >= 0))\npayment_order_payment_status_check: CHECK ((payment_status = ANY (ARRAY[\'CREATING\'::text, \'PENDING\'::text, \'UNKNOWN\'::text, \'PARTIAL\'::text, \'PAID\'::text, \'UNPAID_TERMINAL\'::text, \'EXCEPTION\'::text, \'DEV_BYPASSED\'::text])))\npayment_order_price_vnd_check: CHECK (((price_vnd >= 1) AND (price_vnd <= \'9007199254740991\'::bigint)))\npayment_order_provider_order_code_check: CHECK (((provider_order_code >= 1) AND (provider_order_code <= \'9007199254740991\'::bigint)))\npayment_order_revision_check: CHECK ((revision >= 0))\nIndex: CREATE UNIQUE INDEX payment_order_pkey ON platform.payment_order USING btree (order_id)\nIndex: CREATE UNIQUE INDEX payment_order_provider_order_code_key ON platform.payment_order USING btree (provider_order_code)\nIndex: CREATE UNIQUE INDEX payment_order_payment_link_id_key ON platform.payment_order USING btree (payment_link_id)\nIndex: CREATE UNIQUE INDEX payment_order_created_by_idempotency_key_key ON platform.payment_order USING btree (created_by, idempotency_key)\nIndex: CREATE UNIQUE INDEX payment_order_intent_id_attempt_key ON platform.payment_order USING btree (intent_id, attempt)\nIndex: CREATE UNIQUE INDEX payment_order_intent_id_order_id_key ON platform.payment_order USING btree (intent_id, order_id)\nIndex: CREATE UNIQUE INDEX payment_one_open_attempt_idx ON platform.payment_order USING btree (intent_id) WHERE (payment_status = ANY (ARRAY[\'CREATING\'::text, \'PENDING\'::text, \'UNKNOWN\'::text, \'PARTIAL\'::text]))\nIndex: CREATE INDEX payment_reconciliation_idx ON platform.payment_order USING btree (last_checked_at, created_at) WHERE (payment_status = ANY (ARRAY[\'CREATING\'::text, \'PENDING\'::text, \'UNKNOWN\'::text, \'PARTIAL\'::text]))\nHIDDEN TARGET - payment_order_plan_id_plan_version_id_fkey: FOREIGN KEY (plan_id, plan_version_id) REFERENCES platform.subscription_plan_version(plan_id, version_id)'
}

