Table platform.target_selection_request {
  "request_id" uuid [not null, pk]
  "actor_id" uuid [not null]
  "operation" text [not null, note: 'Default expression: \'SELECT_TARGET_ROLE\'::text']
  "idempotency_key" text [not null]
  "request_hash" "platform.content_hash" [not null, note: 'Domain base type: text. Domain constraints: CHECK ((VALUE ~ \'^[0-9a-f]{64}$\'::text))']
  "status" text [not null, note: 'Default expression: \'PENDING\'::text']
  "result_selection_id" uuid [null]
  "result_target_revision" bigint [null]
  "result_changed" boolean [null]
  "outcome_code" text [null]
  "created_at" "timestamp with time zone" [not null, note: 'Default expression: now()']
  "completed_at" "timestamp with time zone" [null]

  indexes {
    ("actor_id", "operation", "idempotency_key") [unique, name: 'target_selection_request_actor_id_operation_idempotency_key_key']
  }

  Note: 'target_selection_request_check: CHECK ((((status = \'PENDING\'::text) AND (completed_at IS NULL) AND (result_selection_id IS NULL) AND (result_target_revision IS NULL) AND (result_changed IS NULL) AND (outcome_code IS NULL)) OR ((status = \'SUCCEEDED\'::text) AND (completed_at IS NOT NULL) AND (result_selection_id IS NOT NULL) AND (result_target_revision IS NOT NULL) AND (result_changed IS NOT NULL) AND (outcome_code IS NULL)) OR ((status = \'REJECTED\'::text) AND (completed_at IS NOT NULL) AND (result_selection_id IS NULL) AND (result_target_revision IS NULL) AND (result_changed IS NULL) AND (outcome_code IS NOT NULL) AND (btrim(outcome_code) <> \'\'::text))))\ntarget_selection_request_idempotency_key_check: CHECK ((btrim(idempotency_key) <> \'\'::text))\ntarget_selection_request_operation_check: CHECK ((operation = \'SELECT_TARGET_ROLE\'::text))\ntarget_selection_request_result_target_revision_check: CHECK ((result_target_revision >= 0))\ntarget_selection_request_status_check: CHECK ((status = ANY (ARRAY[\'PENDING\'::text, \'SUCCEEDED\'::text, \'REJECTED\'::text])))\nIndex: CREATE UNIQUE INDEX target_selection_request_pkey ON platform.target_selection_request USING btree (request_id)\nIndex: CREATE UNIQUE INDEX target_selection_request_actor_id_operation_idempotency_key_key ON platform.target_selection_request USING btree (actor_id, operation, idempotency_key)\nIndex: CREATE INDEX target_selection_request_pending_idx ON platform.target_selection_request USING btree (created_at) WHERE (status = \'PENDING\'::text)'
}

