  Note: 'subscription_intent_check: CHECK ((((kind = \'PURCHASE\'::text) AND (registration_id IS NOT NULL) AND (organization_id IS NULL)) OR ((kind = \'RENEWAL\'::text) AND (registration_id IS NULL) AND (organization_id IS NOT NULL))))\nsubscription_intent_check1: CHECK (((state = \'APPLIED\'::text) = (applied_order_id IS NOT NULL)))\nsubscription_intent_kind_check: CHECK ((kind = ANY (ARRAY[\'PURCHASE\'::text, \'RENEWAL\'::text])))\nsubscription_intent_state_check: CHECK ((state = ANY (ARRAY[\'OPEN\'::text, \'APPLYING\'::text, \'WAITING_CAPACITY\'::text, \'APPLIED\'::text, \'EXCEPTION\'::text])))\nIndex: CREATE UNIQUE INDEX subscription_intent_pkey ON platform.subscription_intent USING btree (intent_id)\nIndex: CREATE UNIQUE INDEX subscription_initial_intent_idx ON platform.subscription_intent USING btree (registration_id) WHERE (kind = \'PURCHASE\'::text)\nIndex: CREATE UNIQUE INDEX subscription_unresolved_renewal_idx ON platform.subscription_intent USING btree (organization_id) WHERE ((kind = \'RENEWAL\'::text) AND (state <> \'APPLIED\'::text))'
}

