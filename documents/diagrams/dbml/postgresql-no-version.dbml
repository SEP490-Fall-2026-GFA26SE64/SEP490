Table platform.baseline_assessment_series {
  "organization_id" uuid [not null]
  "occupation_id" text [not null]
  "blueprint_id" uuid [not null, unique, note: 'FK target hidden intentionally: platform.baseline_blueprint_version (blueprint_id, version); constraint baseline_assessment_series_blueprint_id_pending_blueprint__fkey']
  "series_revision" bigint [not null, note: 'Optimistic compare-and-set revision; incremented once for every audited pointer transition.\nDefault expression: 1']
  "working_revision_id" uuid [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_working_revision (working_revision_id); constraint baseline_assessment_series_working_revision_fk']
  "pending_blueprint_version" integer [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_version (blueprint_id, version); constraint baseline_assessment_series_blueprint_id_pending_blueprint__fkey']
  "open_assessment_version_id" uuid [null, note: 'FK target hidden intentionally: platform.assessment_version (assessment_version_id); constraint baseline_assessment_series_open_assessment_version_id_fkey']
  "active_assessment_version_id" uuid [null, note: 'FK target hidden intentionally: platform.assessment_version (assessment_version_id); constraint baseline_assessment_series_active_assessment_version_id_fkey']
  "created_at" "timestamp with time zone" [not null, note: 'Default expression: now()']
  "updated_at" "timestamp with time zone" [not null, note: 'Default expression: now()']

  indexes {
    ("organization_id", "occupation_id") [pk, name: 'baseline_assessment_series_pkey']
  }

  Note: 'Tenant + Occupation coordination row and first lock for baseline lifecycle writes.\nbaseline_assessment_series_check: CHECK (((working_revision_id IS NULL) OR (pending_blueprint_version IS NULL)))\nbaseline_assessment_series_check1: CHECK (((open_assessment_version_id IS NULL) OR (open_assessment_version_id IS DISTINCT FROM active_assessment_version_id)))\nbaseline_assessment_series_occupation_id_check: CHECK ((btrim(occupation_id) <> \'\'::text))\nbaseline_assessment_series_pending_blueprint_version_check: CHECK ((pending_blueprint_version > 0))\nbaseline_assessment_series_series_revision_check: CHECK ((series_revision > 0))\nIndex: CREATE UNIQUE INDEX baseline_assessment_series_pkey ON platform.baseline_assessment_series USING btree (organization_id, occupation_id)\nIndex: CREATE UNIQUE INDEX baseline_assessment_series_blueprint_id_key ON platform.baseline_assessment_series USING btree (blueprint_id)\nIndex: CREATE UNIQUE INDEX baseline_assessment_series_open_candidate_unique ON platform.baseline_assessment_series USING btree (open_assessment_version_id) WHERE (open_assessment_version_id IS NOT NULL)\nIndex: CREATE UNIQUE INDEX baseline_assessment_series_active_release_unique ON platform.baseline_assessment_series USING btree (active_assessment_version_id) WHERE (active_assessment_version_id IS NOT NULL)\nHIDDEN TARGET - baseline_assessment_series_active_assessment_version_id_fkey: FOREIGN KEY (active_assessment_version_id) REFERENCES platform.assessment_version(assessment_version_id)\nHIDDEN TARGET - baseline_assessment_series_blueprint_id_pending_blueprint__fkey: FOREIGN KEY (blueprint_id, pending_blueprint_version) REFERENCES platform.baseline_blueprint_version(blueprint_id, version)\nHIDDEN TARGET - baseline_assessment_series_open_assessment_version_id_fkey: FOREIGN KEY (open_assessment_version_id) REFERENCES platform.assessment_version(assessment_version_id)\nHIDDEN TARGET - baseline_assessment_series_working_revision_fk: FOREIGN KEY (working_revision_id) REFERENCES platform.baseline_blueprint_working_revision(working_revision_id)'
}

Table platform.baseline_assessment_transition {
  "transition_id" uuid [not null, pk, note: 'Default expression: gen_random_uuid()']
  "organization_id" uuid [not null]
  "occupation_id" text [not null]
  "series_revision" bigint [not null]
  "transition" text [not null]
  "actor_id" uuid [not null]
  "occurred_at" "timestamp with time zone" [not null]
  "reason" text [null]
  "previous_working_revision_id" uuid [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_working_revision (working_revision_id); constraint baseline_assessment_transitio_previous_working_revision_id_fkey']
  "previous_pending_blueprint_id" uuid [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_version (blueprint_id, version); constraint baseline_assessment_transitio_previous_pending_blueprint_i_fkey']
  "previous_pending_blueprint_version" integer [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_version (blueprint_id, version); constraint baseline_assessment_transitio_previous_pending_blueprint_i_fkey']
  "previous_open_assessment_version_id" uuid [null, note: 'FK target hidden intentionally: platform.assessment_version (assessment_version_id); constraint baseline_assessment_transitio_previous_open_assessment_ver_fkey']
  "previous_active_assessment_version_id" uuid [null, note: 'FK target hidden intentionally: platform.assessment_version (assessment_version_id); constraint baseline_assessment_transitio_previous_active_assessment_v_fkey']
  "working_revision_id" uuid [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_working_revision (working_revision_id); constraint baseline_assessment_transition_working_revision_id_fkey']
  "pending_blueprint_id" uuid [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_version (blueprint_id, version); constraint baseline_assessment_transitio_pending_blueprint_id_pending_fkey']
  "pending_blueprint_version" integer [null, note: 'FK target hidden intentionally: platform.baseline_blueprint_version (blueprint_id, version); constraint baseline_assessment_transitio_pending_blueprint_id_pending_fkey']
  "open_assessment_version_id" uuid [null, note: 'FK target hidden intentionally: platform.assessment_version (assessment_version_id); constraint baseline_assessment_transition_open_assessment_version_id_fkey']
  "active_assessment_version_id" uuid [null, note: 'FK target hidden intentionally: platform.assessment_version (assessment_version_id); constraint baseline_assessment_transitio_active_assessment_version_id_fkey']

  indexes {
    ("organization_id", "occupation_id", "series_revision") [unique, name: 'baseline_assessment_transitio_organization_id_occupation_id_key']
  }

  Note: 'baseline_assessment_transition_check: CHECK (((previous_pending_blueprint_id IS NULL) = (previous_pending_blueprint_version IS NULL)))\nbaseline_assessment_transition_check1: CHECK (((pending_blueprint_id IS NULL) = (pending_blueprint_version IS NULL)))\nbaseline_assessment_transition_reason_check: CHECK (((reason IS NULL) OR (btrim(reason) <> \'\'::text)))\nbaseline_assessment_transition_series_revision_check: CHECK ((series_revision > 1))\nbaseline_assessment_transition_transition_check: CHECK ((transition = ANY (ARRAY[\'WORKING_REVISION_STARTED\'::text, \'WORKING_REVISION_SAVED\'::text, \'BLUEPRINT_FINALIZED\'::text, \'ASSESSMENT_DRAFT_OPENED\'::text, \'ASSESSMENT_DRAFT_EDITED\'::text, \'ASSESSMENT_REVIEWED\'::text, \'REVIEWED_CANDIDATE_REPLACED\'::text, \'ACTIVE_ASSESSMENT_SWITCHED\'::text, \'HISTORICAL_ASSESSMENT_RESTORED\'::text, \'ACTIVE_ASSESSMENT_DISABLED\'::text, \'PENDING_CHANGE_ABANDONED\'::text])))\nIndex: CREATE UNIQUE INDEX baseline_assessment_transition_pkey ON platform.baseline_assessment_transition USING btree (transition_id)\nIndex: CREATE UNIQUE INDEX baseline_assessment_transitio_organization_id_occupation_id_key ON platform.baseline_assessment_transition USING btree (organization_id, occupation_id, series_revision)\nIndex: CREATE INDEX baseline_assessment_transition_scope_time_idx ON platform.baseline_assessment_transition USING btree (organization_id, occupation_id, occurred_at DESC)\nHIDDEN TARGET - baseline_assessment_transitio_active_assessment_version_id_fkey: FOREIGN KEY (active_assessment_version_id) REFERENCES platform.assessment_version(assessment_version_id)\nHIDDEN TARGET - baseline_assessment_transitio_pending_blueprint_id_pending_fkey: FOREIGN KEY (pending_blueprint_id, pending_blueprint_version) REFERENCES platform.baseline_blueprint_version(blueprint_id, version)\nHIDDEN TARGET - baseline_assessment_transitio_previous_active_assessment_v_fkey: FOREIGN KEY (previous_active_assessment_version_id) REFERENCES platform.assessment_version(assessment_version_id)\nHIDDEN TARGET - baseline_assessment_transitio_previous_open_assessment_ver_fkey: FOREIGN KEY (previous_open_assessment_version_id) REFERENCES platform.assessment_version(assessment_version_id)\nHIDDEN TARGET - baseline_assessment_transitio_previous_pending_blueprint_i_fkey: FOREIGN KEY (previous_pending_blueprint_id, previous_pending_blueprint_version) REFERENCES platform.baseline_blueprint_version(blueprint_id, version)\nHIDDEN TARGET - baseline_assessment_transitio_previous_working_revision_id_fkey: FOREIGN KEY (previous_working_revision_id) REFERENCES platform.baseline_blueprint_working_revision(working_revision_id)\nHIDDEN TARGET - baseline_assessment_transition_open_assessment_version_id_fkey: FOREIGN KEY (open_assessment_version_id) REFERENCES platform.assessment_version(assessment_version_id)\nHIDDEN TARGET - baseline_assessment_transition_working_revision_id_fkey: FOREIGN KEY (working_revision_id) REFERENCES platform.baseline_blueprint_working_revision(working_revision_id)'
}

Table platform.baseline_attempt_command {
  "organization_id" uuid [not null]
  "actor_id" uuid [not null]
  "idempotency_key" text [not null]
  "attempt_id" uuid [not null]
  "occupation_id" text [not null]
  "operation" text [not null]
  "request_hash" "platform.content_hash" [not null, note: 'Domain base type: text. Domain constraints: CHECK ((VALUE ~ \'^[0-9a-f]{64}$\'::text))']
  "response_payload" jsonb [not null]
  "created_at" "timestamp with time zone" [not null]

  indexes {
    ("organization_id", "actor_id", "idempotency_key") [pk, name: 'baseline_attempt_command_pkey']
  }

  Note: 'Server-only immutable command outcomes keyed by organization/Employee/key across Occupations and operations; reauthorize before replay.\nbaseline_attempt_command_idempotency_key_check: CHECK (((idempotency_key <> \'\'::text) AND (idempotency_key = btrim(idempotency_key)) AND (char_length(idempotency_key) <= 200)))\nbaseline_attempt_command_operation_check: CHECK ((operation = ANY (ARRAY[\'START\'::text, \'ANSWER\'::text, \'SUBMIT\'::text])))\nbaseline_attempt_command_response_payload_check: CHECK ((jsonb_typeof(response_payload) = \'object\'::text))\nIndex: CREATE UNIQUE INDEX baseline_attempt_command_pkey ON platform.baseline_attempt_command USING btree (organization_id, actor_id, idempotency_key)\nIndex: CREATE INDEX baseline_attempt_command_attempt_idx ON platform.baseline_attempt_command USING btree (attempt_id, created_at)'
}

Table platform.baseline_attempt_item {
  "attempt_id" uuid [not null]
  "organization_id" uuid [not null]
