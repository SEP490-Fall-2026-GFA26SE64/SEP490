@startuml
!pragma layout smetana
left to right direction
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
title PostgreSQL r3 - requirement-root pathway and certificate decisions - TARGET, not applied
class "Existing Role selection" as sel {
  Own org / learner / selected Role + Level
  Existing learner transaction serialization
  Lock from accepted pathway request
  No archive bypass for unfinished work
  Same target is a reauthorized no-op
}
class "Existing request / run / revision" as request {
  New requirement_snapshot_id + flow version
  No synthetic old numeric baseline/profile
  Existing claim / lease / receipt / history
  Initial exact Expert approval retained
  Auto revisions retain approval basis
}
class "pathway_requirement_step" as step {
  Owned request + revision + skill + level
  Mode / outcomes / state / source
  REQUIRED or PARALLEL_SUPPLEMENT
  One successful option satisfies step
  Cần bổ sung differs from ACHIEVED
}
class "Option + requirement dependency" as option {
  Option: module / content / exact outcomes
  Dependency: same-revision step pair
  All eligible equivalent module options
  No initial unassessed prerequisite closure
  No old parallel bypass gate on new target
}
class "Existing content progress" as learning {
  Lesson reader / content pins unchanged
  Completion requirement mapping sidecar
  Independent progress for each module
  Content completion alone is not achieved
  All entry routes enforce live guards
}
class "Certificate submission / decision" as cert {
  Exact learner / skill-level / definition version
  One HTTPS link OR PDF OR PNG/JPEG
  Private file key; <=10 MiB where applicable
  Actual authorized Expert approves/rejects
  Approval creates official evidence once
}
class "Scoped bypass + parallel follow-up" as bypass {
  Original Employee/pathway/requirement
  Expert + assignment + reason + history
  Bypass never becomes achievement
  After new target: learn in parallel
  Later provision does not gate new skills
}
class "Accepted results / recalculation" as evidence {
  Official evidence / diagnostic / NEED_REVIEW stay separate
  Skill assessment discovers missing prerequisite: Cần bổ sung
  Auto add/reuse eligible requirement work without duplicate loops
  Keep completed work; all full-retake/veto rules apply
  Audit/outbox/receipt preserve coherent authorized outcomes
}
sel --> request : bind
request --> step : contains
step --> option : choices / gates
option --> learning : learn
cert --> evidence : authorized approval
learning --> evidence : + skill assessment
option --> bypass : missing + Expert waiver
bypass --> evidence : parallel context
@enduml