# Adapt-Learn-Graph on-premises deployment environment (compose.deploy.yml).
# Copy to $APP_DIR/.env on the server (chmod 600) and fill in real values there.
# Never commit the real file. DOCKERHUB_USERNAME and IMAGE_TAG are injected by the workflow.

# ---- Public origin (HTTPS). Used for PayOS return/cancel/webhook URLs and email links ----
PUBLIC_URL=https://adaptlearn.id.vn
# Host port that Nginx proxies to (bound to 127.0.0.1 only). Keep in sync with deploy/nginx/*.conf.
WEB_PORT=8088

# ---- Private RIASEC inference ----
# The API route needs this enablement; AI also needs a real model and service.
RIASEC_ENABLED=true
# Defaults also apply when these keys are missing or empty in an existing server .env.
# Override to match the deployment host; rollout capacity checks still apply.
RIASEC_MODEL=qwen3:4b-instruct-2507-q4_K_M
RIASEC_OLLAMA_MEMORY=5g
RIASEC_OLLAMA_CPUS=2

# ---- Data stores (strong, independent passwords; changing them later does NOT rotate existing volumes) ----
DB_PASSWORD=
NEO4J_PASSWORD=
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m

# ---- Private learning asset storage (MinIO, not published to the host) ----
LEARNING_ASSETS_ACCESS_KEY=
LEARNING_ASSETS_SECRET_KEY=
LEARNING_ASSETS_BUCKET=learning-content
# Optional override; defaults to the source-built image the workflow pushes to Docker Hub.
MINIO_IMAGE=

# ---- Registration secrets: two independent random 32-byte Base64 values ----
# Generate each with: openssl rand -base64 32
# Keep stable and back them up with the database; replacing them breaks MFA secrets/email proofs.
REGISTRATION_ENCRYPTION_KEY=
REGISTRATION_HMAC_KEY=

# ---- Seeded demo workspace accounts: private password (never the public dev default) ----
WORKSPACE_DEVELOPMENT_PASSWORD=

# ---- Platform administrator (required) ----
# Created automatically on deploy by the platform-seed job. Once the account exists, later deploys
# leave it unchanged (changing the password in the app is safe; editing these values does not reset it).
# Password: at least 12 characters.
PLATFORM_ADMIN_SEED_EMAIL=
PLATFORM_ADMIN_SEED_PASSWORD=

# ---- SMTP (STARTTLS on 587; implicit TLS/465 is not supported by the app) ----
# Gmail: smtp.gmail.com + full address + an App Password (2-Step Verification required).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# ---- Feature policy ----
EMAIL_VERIFICATION_ENABLED=true
MFA_ENABLED=true
LEARNING_MAIL_ENABLED=true

# ---- PayOS merchant API (https://my.payos.vn > Payment channel > API keys) ----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Each deploy registers ${PUBLIC_URL}/api/v1/payments/payos/webhook with PayOS (confirm-webhook).
PAYOS_CONFIRM_WEBHOOK=true

# ---- JVM ----
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
