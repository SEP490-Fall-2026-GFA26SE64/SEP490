# Local development configuration for compose.dev.yml.
# Copy to .env, or use an ignored file such as .env.registration-live with
# docker compose --env-file .env.registration-live -f compose.dev.yml ...
# Fill in secrets privately; never commit them or paste them into chat.
# Full setup and key-generation instructions:
# documents/testing/system/REQ-060-registration-manual-check.md

# Database credentials: use strong, independent passwords for real accounts.
# Blank values use development-only fallbacks in compose.dev.yml.
# Changing these values does not rotate passwords in existing database volumes.
# PostgreSQL user/database: adapt_learn_graph.
DB_PASSWORD=
# Neo4j user: neo4j.
NEO4J_PASSWORD=

# Host ports, bound to 127.0.0.1 by development Compose.
# Choose unused ports for parallel stacks; container-internal ports stay unchanged.
# PostgreSQL client connections.
POSTGRES_PORT=15432
# Neo4j Browser: http://127.0.0.1:7474
NEO4J_HTTP_PORT=7474
# Neo4j Bolt connections from host tools.
NEO4J_BOLT_PORT=7687
# Direct backend API: http://127.0.0.1:18080
API_PORT=18080
# Frontend: http://127.0.0.1:8088/guest/register
WEB_PORT=8088

# Registration secrets: generate two independent, cryptographically random
# 32-byte values and Base64-encode each one. Do not reuse the same key.
# Never use disposable test keys for live accounts. Missing keys disable registration.
# Keep keys stable and private alongside the database; replacing them without a
# migration/rotation plan breaks existing encrypted factors or verification hashes.
# AES-GCM encryption key for TOTP secrets and queued email proofs.
REGISTRATION_ENCRYPTION_KEY=
# HMAC key for email/recovery proofs and rate-limit bucket identifiers.
REGISTRATION_HMAC_KEY=
# false is for loopback HTTP development only. Use true with HTTPS.
# Secure cookies are not sent over ordinary HTTP, which can prevent local sign-in.
REGISTRATION_COOKIE_SECURE=false

# SMTP delivery: configure a real provider for live email verification.
# Missing host/from settings disable registration; accepted SMTP delivery alone
# does not prove inbox receipt. The isolated test override uses Mailpit instead.
# Gmail: smtp.gmail.com
SMTP_HOST=
# Gmail uses port 587 with STARTTLS; implicit TLS on port 465 is not configured here.
SMTP_PORT=587
# Gmail: full sender email address.
SMTP_USERNAME=
# Gmail: an app password for an eligible account with 2-Step Verification enabled,
# not the normal Google account password. Configure it only in your private file.
SMTP_PASSWORD=
# Authorized sender address, normally the same Gmail address as SMTP_USERNAME.
SMTP_FROM=
# Keep true for Gmail. false is only for an isolated SMTP capture service.
SMTP_AUTH=true
# Enables AND requires STARTTLS. Keep true for Gmail; false only for isolated capture.
SMTP_STARTTLS=true

# Subscription checkout uses only the official payOS merchant API.
# Leave these blank for local work without merchant traffic; configure privately.
# No sandbox or successful-payment fallback is supplied.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Browser return/cancel location. Production requires HTTPS; loopback HTTP is local only.
SUBSCRIPTION_PUBLIC_URL=http://127.0.0.1:8088
SUBSCRIPTION_WORKER_ENABLED=true

# Optional one-time Platform Administrator seed. No default credentials.
# Password must contain 12-128 characters. Keep these values private.
# After migrations/API update: docker compose -f compose.dev.yml run --rm --no-deps platform-seed
# Repeating the same seed is safe; conflicting accounts/passwords are not overwritten.
# This account uses password-only login, without email verification or MFA.
PLATFORM_ADMIN_SEED_EMAIL=
PLATFORM_ADMIN_SEED_PASSWORD=

# Shared workspace-development fixture: real login, separate main-lineage data volumes.
# Public development-only password; set before first startup. Repeated seed refuses password/identity drift.
WORKSPACE_DEVELOPMENT_PASSWORD=Workspace-Development-490!
# Session encryption/HMAC keys for this dev stack are generated once in workspace_security.
# No learner outcomes or real payment is seeded. Production does not activate these fixtures.
