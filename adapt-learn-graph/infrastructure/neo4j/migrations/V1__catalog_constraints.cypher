CREATE CONSTRAINT job_domain_version IF NOT EXISTS FOR (entity:JobDomain) REQUIRE (entity.domainId, entity.versionId) IS UNIQUE;
CREATE CONSTRAINT target_role_version IF NOT EXISTS FOR (entity:TargetRole) REQUIRE (entity.roleId, entity.versionId) IS UNIQUE;
CREATE CONSTRAINT macro_competency_version IF NOT EXISTS FOR (entity:MacroCompetency) REQUIRE (entity.macroId, entity.versionId) IS UNIQUE;
CREATE CONSTRAINT micro_skill_version IF NOT EXISTS FOR (entity:MicroSkill) REQUIRE (entity.skillId, entity.versionId) IS UNIQUE;
CREATE CONSTRAINT learning_module_version IF NOT EXISTS FOR (entity:LearningModule) REQUIRE (entity.moduleId, entity.versionId) IS UNIQUE;
CREATE CONSTRAINT catalog_release_id IF NOT EXISTS FOR (release:CatalogRelease) REQUIRE release.releaseId IS UNIQUE;
CREATE CONSTRAINT catalog_source_revision IF NOT EXISTS FOR (release:CatalogRelease) REQUIRE release.sourceRevision IS UNIQUE;
CREATE CONSTRAINT publication_event_id IF NOT EXISTS FOR (marker:PublicationMarker) REQUIRE marker.eventId IS UNIQUE;
CREATE CONSTRAINT availability_revision_id IF NOT EXISTS FOR (availability:AvailabilityRevision) REQUIRE availability.availabilityId IS UNIQUE;
CREATE CONSTRAINT availability_entity_revision IF NOT EXISTS FOR (availability:AvailabilityRevision) REQUIRE (availability.entityId, availability.revision) IS UNIQUE;
CREATE INDEX publication_marker_release IF NOT EXISTS FOR (marker:PublicationMarker) ON (marker.releaseId);
CREATE INDEX availability_release IF NOT EXISTS FOR (availability:AvailabilityRevision) ON (availability.releaseId);
CREATE INDEX job_domain_code IF NOT EXISTS FOR (entity:JobDomain) ON (entity.domainCode);
CREATE INDEX target_role_code IF NOT EXISTS FOR (entity:TargetRole) ON (entity.roleCode);
CREATE INDEX macro_competency_code IF NOT EXISTS FOR (entity:MacroCompetency) ON (entity.macroCode);
CREATE INDEX micro_skill_code IF NOT EXISTS FOR (entity:MicroSkill) ON (entity.skillCode);
CREATE INDEX learning_module_code IF NOT EXISTS FOR (entity:LearningModule) ON (entity.moduleCode);
CREATE INDEX has_role_release IF NOT EXISTS FOR ()-[relation:HAS_ROLE]-() ON (relation.releaseId);
CREATE INDEX requires_macro_release IF NOT EXISTS FOR ()-[relation:REQUIRES_MACRO]-() ON (relation.releaseId);
CREATE INDEX has_skill_release IF NOT EXISTS FOR ()-[relation:HAS_SKILL]-() ON (relation.releaseId);
CREATE INDEX requires_skill_release IF NOT EXISTS FOR ()-[relation:REQUIRES_SKILL]-() ON (relation.releaseId);
CREATE INDEX prerequisite_release IF NOT EXISTS FOR ()-[relation:PREREQUISITE_OF]-() ON (relation.releaseId);
CREATE INDEX teaches_release IF NOT EXISTS FOR ()-[relation:TEACHES]-() ON (relation.releaseId);
CREATE INDEX entry_requirement_release IF NOT EXISTS FOR ()-[relation:HAS_ENTRY_REQUIREMENT]-() ON (relation.releaseId);